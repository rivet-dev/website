node_modules/
# Root build output only. packages/icons/dist is prebuilt and committed: it
# inlines Font Awesome Pro definitions, so building it here would need a Pro
# token.
/dist/
.astro/
.turbo/
.DS_Store
*.log

# Generated at build time
src/generated/

# Assembled by scripts/assemble.mjs — each product's docs are symlinked in from
# its own repo (sibling checkout) or from vendor/ as a fallback. Never commit
# these; edit the source repo instead.
# No trailing slashes: these are symlinks, not directories, and a trailing
# slash matches only directories. With one, git happily tracks the link itself
# and a developer's local target path ends up committed.
src/content/docs/actors
src/content/docs/agentos
src/content/docs/cloud
src/content/docs/dynamic-apps
src/content/docs/workflows

# Written into public/ by `pnpm gen:markdown` and `pnpm gen:skills`: the
# Markdown mirror of every docs page, and the per-product AI skills. Derived
# from the docs on every build, so never committed.
/public/actors/
/public/agentos/
/public/cloud/
/public/dynamic-apps/
/public/workflows/
/public/metadata/

# Local manifests for orb service portals.
/.amp/portals/
