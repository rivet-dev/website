# Keep the build context small and force a clean install inside the image.
# Host node_modules contain platform-specific binaries (sharp, esbuild, workerd)
# that must not leak into the Linux builder stage.
node_modules
packages/*/node_modules

# Build output is regenerated by `pnpm run build` in the builder stage.
/dist
.astro
.turbo

# Assembled by scripts/assemble.ts inside the image from vendor/.
src/content/docs/actors
src/content/docs/agentos
src/content/docs/dynamic-apps
src/content/docs/workflows
src/generated

# Generated into public/ by the build.
/public/actors
/public/agentos
/public/cloud
/public/dynamic-apps
/public/workflows
/public/metadata

# Generated by scripts/generate-caddy-redirects.mjs in the builder stage.
redirects.caddy

.git
.github
*.log
.DS_Store
