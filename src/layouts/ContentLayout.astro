---
import BaseLayout from './BaseLayout.astro';
import { Header } from '@/components/v2/Header';
import { Prose } from '@/components/Prose';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	frontmatter?: { title?: string; description?: string; canonicalUrl?: string };
}

// MDX pages deliver frontmatter under Astro.props.frontmatter, not as top-level props.
const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title;
const description = Astro.props.description ?? frontmatter?.description;
const canonicalUrl = Astro.props.canonicalUrl ?? frontmatter?.canonicalUrl;
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
	<Header variant="floating" client:load />
	<div class="paper-grain md:mt-32 mt-20 pb-8 px-6" style="--header-height: 5rem;">
		<Prose as="article" surface="paper" className="order-3 mt-4 w-full flex-shrink-0 lg:order-2 max-w-prose mx-auto">
			<slot />
		</Prose>
	</div>
</BaseLayout>

<!-- Legal/content pages sit on the porcelain field. -->
<style is:global>
	body {
		background-color: #efefef;
	}
</style>
