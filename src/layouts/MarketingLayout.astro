---
import type { ComponentProps } from 'react';
import BaseLayout from './BaseLayout.astro';
import { Header } from '@/components/v2/Header';
import { SITE_PAGE_CLASS } from '@/components/marketing/layout';
import { activeDocsTab } from '@/sitemap/docsTabs';
import { getProduct } from '@/sitemap/products';

interface Props {
	title: string;
	description?: string;
	canonicalUrl?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	keywords?: string[];
	active?: ComponentProps<typeof Header>['active'];
	robots?: string;
	preconnectAssets?: boolean;
	/**
	 * Set on pages that belong to a docs tab (for example a product registry) or
	 * to a standalone product subsite. Switches from the floating pill header to
	 * the same two-row header the docs use, so the subnav stays identical across
	 * the section. Other pages keep the floating header even when a product is set.
	 */
	productId?: string;
	/** Which tab of the product to mark active. Defaults to Overview. */
	tabId?: string;
}

const {
	title,
	description,
	canonicalUrl,
	ogImage,
	ogImageAlt,
	ogImageWidth,
	ogImageHeight,
	keywords,
	active,
	robots,
	preconnectAssets,
	productId,
	tabId = 'overview',
} = Astro.props;
const pathname = Astro.url.pathname;
// Standalone subsites (agentOS, Secure Exec) always take the two-row header:
// their product bar is the subnav on every page of the subsite.
const showDocsHeader =
	productId !== undefined &&
	(getProduct(productId)?.standalone === true || activeDocsTab(pathname) !== undefined);
---

<BaseLayout
	title={title}
	description={description}
	canonicalUrl={canonicalUrl}
	ogImage={ogImage}
	ogImageAlt={ogImageAlt}
	ogImageWidth={ogImageWidth}
	ogImageHeight={ogImageHeight}
	keywords={keywords}
	robots={robots}
	preconnectAssets={preconnectAssets}
	pageFamily="site"
>
	{showDocsHeader ? (
		<Header
			variant="full-width"
			light={true}
			showProductBar={true}
			productId={productId}
			tabId={tabId}
			initialPathname={pathname}
			active={active}
			pageFamily="site"
			client:load
		/>
	) : (
		<Header variant="floating" initialPathname={pathname} active={active} pageFamily="site" client:load />
	)}
	<div class={SITE_PAGE_CLASS}>
		<slot />
	</div>
</BaseLayout>
