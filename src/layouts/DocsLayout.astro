---
import BaseLayout from './BaseLayout.astro';
import { Header } from '@/components/v2/Header';
import type { SidebarItem } from '@/lib/sitemap';

interface Props {
	title: string;
	description?: string;
	canonicalUrl?: string;
	robots?: string;
	sidebar?: SidebarItem[];
	/** Product vertical this page belongs to; omitted outside the verticals. */
	productId?: string;
	tabId?: string;
	/** Identity for docs sections that are not a product vertical. */
	sectionLabel?: string;
}

const { title, description, canonicalUrl, robots, sidebar, productId, tabId, sectionLabel } = Astro.props;
const pathname = Astro.url.pathname;
// Some tabs are a single page rather than a section (Use Cases). Without a
// sidebar the two-column docs grid would leave an empty gutter, so the content
// gets the full width instead.
const hasSidebar = (sidebar?.length ?? 0) > 0;
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl} robots={robots} themeColor="#EFEFEF">
	<Header variant="full-width" showProductBar={true} light={true} active="docs" sidebarData={sidebar} initialPathname={pathname} productId={productId} tabId={tabId} sectionLabel={sectionLabel} client:load />
	<div class="paper-grain selection-paper w-full relative z-10 font-sans">
		<div
			class:list={[
				'mx-auto w-full min-h-content flex flex-col',
				hasSidebar && 'md:grid md:grid-cols-docs',
			]}
			style="--header-height: 7.5625rem;"
		>
			<slot />
		</div>
	</div>
</BaseLayout>

<!-- Docs sit on the porcelain field, matching the marketing pages. The body
     itself is painted so overscroll and short pages never flash the dark
     base. Learn keeps its own dark shell. -->
<style is:global>
	body {
		background-color: #efefef;
	}
</style>
