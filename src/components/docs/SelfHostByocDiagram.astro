<figure class="not-prose mx-auto my-10 max-w-[760px] overflow-x-auto">
  <svg viewBox="0 0 760 320" role="img" aria-labelledby="self-host-byoc-title self-host-byoc-description" class="block w-full min-w-[660px]" xmlns="http://www.w3.org/2000/svg">
    <title id="self-host-byoc-title">Bring your own cloud, managed by Rivet</title>
    <desc id="self-host-byoc-description">Your VPC contains your workers, the Rivet operator, control plane and FoundationDB storage. The operator pulls commands from Rivet Cloud and manages the control plane and storage. Workers connect to the control plane inside your VPC.</desc>
    <defs>
      <marker id="self-host-byoc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="rgb(var(--site-pine, 46 64 52))" /></marker>
    </defs>
    <g font-family="system-ui,sans-serif" fill="rgb(var(--site-ink, 27 25 22))">
      <rect x="190" y="25" width="550" height="270" rx="10" fill="rgb(var(--site-paper-mid, 250 248 243))" stroke="rgb(var(--site-pine, 46 64 52))" stroke-width="1.4" stroke-dasharray="7 6" />
      <text x="212" y="51" font-size="11" font-family="ui-monospace,monospace" font-weight="600" letter-spacing="0.14em" fill="rgb(var(--site-pine, 46 64 52))">YOUR VPC</text>
      <rect x="20" y="80" width="134" height="52" rx="7" fill="rgb(var(--site-surface, 255 255 255))" stroke="rgb(var(--site-ink, 27 25 22))" stroke-width="1.4" />
      <text x="87" y="112" text-anchor="middle" font-size="14" font-weight="600">Rivet Cloud</text>
      <rect x="338" y="80" width="204" height="52" rx="7" fill="rgb(var(--site-surface, 255 255 255))" stroke="rgb(var(--site-ink, 27 25 22))" stroke-width="1.4" />
      <text x="440" y="112" text-anchor="middle" font-size="14" font-weight="600">Rivet operator</text>
      <path d="M338 106 H156" fill="none" stroke="rgb(var(--site-pine, 46 64 52))" stroke-width="1.4" marker-end="url(#self-host-byoc-arrow)" />
      <text x="255" y="94" text-anchor="middle" font-size="12">Pull commands</text>
      <path d="M440 132 V186" fill="none" stroke="rgb(var(--site-pine, 46 64 52))" stroke-width="1.4" marker-end="url(#self-host-byoc-arrow)" />
      <text x="454" y="165" font-size="12" fill="rgb(var(--site-ink-soft, 86 82 74))">Updates &amp; maintenance</text>

      <rect x="380" y="188" width="348" height="76" rx="8" fill="none" stroke="rgb(var(--site-pine, 46 64 52))" stroke-opacity=".35" stroke-dasharray="2 5" />
      <rect x="214" y="200" width="140" height="52" rx="7" fill="rgb(var(--site-surface, 255 255 255))" stroke="rgb(var(--site-ink, 27 25 22))" stroke-width="1.4" />
      <text x="284" y="222" text-anchor="middle" font-size="14" font-weight="600">Worker</text>
      <text x="284" y="242" text-anchor="middle" font-size="12" fill="rgb(var(--site-ink-soft, 86 82 74))">(your code)</text>
      <rect x="392" y="200" width="144" height="52" rx="7" fill="rgb(var(--site-pine, 46 64 52) / 0.12)" stroke="rgb(var(--site-ink, 27 25 22))" stroke-width="1.4" />
      <text x="464" y="231" text-anchor="middle" font-size="14" font-weight="600">Control plane</text>
      <rect x="572" y="200" width="144" height="52" rx="7" fill="rgb(var(--site-surface, 255 255 255))" stroke="rgb(var(--site-ink, 27 25 22))" stroke-width="1.4" />
      <text x="644" y="222" text-anchor="middle" font-size="14" font-weight="600">Storage</text>
      <text x="644" y="242" text-anchor="middle" font-size="12" fill="rgb(var(--site-ink-soft, 86 82 74))">FoundationDB</text>
      <path d="M356 226 H390" fill="none" stroke="rgb(var(--site-pine, 46 64 52))" stroke-width="1.4" marker-start="url(#self-host-byoc-arrow)" marker-end="url(#self-host-byoc-arrow)" />
      <path d="M538 226 H570" fill="none" stroke="rgb(var(--site-pine, 46 64 52))" stroke-width="1.4" marker-start="url(#self-host-byoc-arrow)" marker-end="url(#self-host-byoc-arrow)" />
      <text x="554" y="284" text-anchor="middle" font-size="12" fill="rgb(var(--site-ink-soft, 86 82 74))">Fully managed by Rivet</text>
    </g>
  </svg>
