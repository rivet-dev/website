---
// Shared renderer for every MDX docs article. Used by the per-product tab route
// (`/[product]/[tab]/[...slug]`) and by the integrations route, which sits
// outside the product verticals. Resolves the entry's route, edit link, and
// extras, then renders it in `DocsArticleLayout`.
import { render } from 'astro:content';
import DocsArticleLayout from '@/components/docs/DocsArticleLayout.astro';
import IntegrationResourceBar from '@/components/docs/IntegrationResourceBar.astro';
import RerootLinks from '@/components/docs/RerootLinks.astro';
import { getContentSlugPath } from '@/lib/content-path';
import { getProductMetadata } from '@/sitemap/product-metadata';
import { integrationFor } from '@/data/integrations';
import {
	INTEGRATIONS_ROUTE_PREFIX,
	PRODUCT_INTEGRATIONS_SEGMENT,
	SITE_INTEGRATIONS_CONTENT_PREFIX,
	SITE_INTEGRATIONS_PRODUCT,
} from '@/sitemap/integrations';
import * as mdxComponents from '@/components/mdx';
import { diagramFromMdx } from '@/components/docs/diagram/fromMdx';
import type { SeoOverrides } from '@/lib/seo';

const {
	entry,
	routePrefix,
	entryIdPrefix = '',
	breadcrumbName = 'Docs',
	productId,
	tabId,
	sectionLabel,
	seoContextLabel,
	// Set when the same guide body is generated for several products, so every
	// copy points search engines at one winner instead of letting Google pick.
	canonicalUrl,
	robots,
	exactTitle = false,
	routeSlugOverride,
	markdownPathOverride,
	editUrlOverride,
	// Link preview card. Defaults to the owning product's card, or the site docs
	// card when no product is set. Sections that live under a product id but are
	// their own thing (Integrations, Deploy, Guides) pass their card explicitly.
	ogImage,
	// Extra MDX components for this page, e.g. the bound product slot renderer.
	extraComponents = {},
} = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const { title, description, seoTitle, seoDescription } = entry.data as {
	title: string;
	description: string;
} & SeoOverrides;
// A section's own overview page has the section root as its id (the glob loader
// collapses `<dir>/index.mdx`), so it resolves to an empty slug rather than
// repeating the prefix.
const routeEntryId = entryIdPrefix && entry.id.startsWith(entryIdPrefix)
	? entry.id.slice(entryIdPrefix.length)
	: entryIdPrefix && `${entry.id}/` === entryIdPrefix
		? ''
		: entry.id;
const slugPath = routeSlugOverride ?? getContentSlugPath(routeEntryId);
// A page that draws a `<Diagram>` previews it instead of the section card, using
// the summary form rendered by `src/pages/og/diagrams/[...id].png.ts`.
const diagramOgImage = entry.collection === 'docs' && diagramFromMdx(entry.body)
	? `/og/diagrams/${entry.id}.png`
	: undefined;
// Integration pages carry a resource bar: the site section's (`/integrations/`,
// its own tab) and a non-site product's (`/<product>/docs/integrations/`).
const integrationSlug = tabId === 'integrations'
	? slugPath
	: tabId === 'docs' && slugPath.startsWith(`${PRODUCT_INTEGRATIONS_SEGMENT}/`)
		? slugPath.slice(PRODUCT_INTEGRATIONS_SEGMENT.length + 1)
		: undefined;
const integration = productId && integrationSlug
	? integrationFor(productId, integrationSlug)
	: undefined;

const componentSourcePath = entry.filePath
	? entry.filePath.replace(/^.*?src\/content\//, '')
	: `docs/${entry.id}.mdx`;

// Product documentation is authored in each product's repository and linked
// into this site's content collection at build time. Keep edit links pointed at
// that source of truth; website-owned collections continue to point at this
// repository.
const normalizedFilePath = entry.filePath?.replaceAll('\\', '/');
const product = productId ? getProductMetadata(productId) : undefined;
const productContentMarker = productId ? `src/content/docs/${productId}/` : undefined;
const productContentPath = normalizedFilePath?.includes('/docs/content/')
	? normalizedFilePath.slice(normalizedFilePath.lastIndexOf('/docs/content/') + '/docs/content/'.length)
	: productContentMarker && normalizedFilePath?.includes(productContentMarker)
		? normalizedFilePath.slice(normalizedFilePath.indexOf(productContentMarker) + productContentMarker.length)
		: `${tabId}/${routeEntryId ? `${routeEntryId}.mdx` : 'index.mdx'}`;
// A shared bundle (`bundleOf`) is authored against its
// source product's routes; its links are re-parented onto this product's.
// The site Integrations section is likewise authored against the Actors
// bundle's `/actors/integrations/` routes and served at `/integrations/`.
const rerootLinks = product?.bundleOf && tabId === 'docs'
	? { from: `/${product.bundleOf}/docs`, to: `/${product.id}/docs` }
	: productId === SITE_INTEGRATIONS_PRODUCT && tabId === 'integrations'
		? { from: `/${SITE_INTEGRATIONS_CONTENT_PREFIX}`, to: INTEGRATIONS_ROUTE_PREFIX }
		: undefined;
const editUrl = editUrlOverride ?? (product
	? product.localBundle
		? `https://github.com/rivet-dev/website/edit/main/${product.localBundle}/docs/content/${productContentPath}`
		: `https://github.com/rivet-dev/${product.repo}/edit/main/${product.bundlePath ?? 'docs'}/content/${productContentPath}`
	: `https://github.com/rivet-dev/website/edit/main/src/content/${componentSourcePath}`);
---

<DocsArticleLayout
	title={title}
	description={description}
	badge={entry.data.badge}
	seoTitle={seoTitle}
	seoDescription={seoDescription}
	headings={headings}
	routePrefix={routePrefix}
	slugPath={slugPath}
	breadcrumbName={breadcrumbName}
	productId={productId}
	tabId={tabId}
	sectionLabel={sectionLabel}
	seoContextLabel={seoContextLabel}
	canonicalUrl={canonicalUrl}
	robots={robots}
	exactTitle={exactTitle}
	ogImage={diagramOgImage ?? ogImage}
	markdownPath={markdownPathOverride}
	editUrl={editUrl}
	lastModified={remarkPluginFrontmatter?.lastModified}
>
	{integration && <IntegrationResourceBar integration={integration} />}
	<RerootLinks from={rerootLinks?.from} to={rerootLinks?.to}>
		<Content components={{ ...mdxComponents, ...extraComponents }} />
	</RerootLinks>
</DocsArticleLayout>
