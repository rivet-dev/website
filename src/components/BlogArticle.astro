---
import { getCollection, render } from 'astro:content';
import { getPostImage } from '@/lib/postImage';
import { ArticleSocials } from '@/components/ArticleSocials';
import { Prose } from '@/components/Prose';
import { formatTimestamp } from '@/lib/formatDate';
import { CATEGORIES } from '@/lib/article';
import { Icon, faArrowLeft, faArrowRight } from '@rivet-gg/icons';
import * as mdxComponents from '@/components/mdx';
import {
	CARD_TITLE_CLASS,
	HERO_H1_CLASS,
	SECTION_H2_CLASS,
	SUBTITLE_CLASS,
} from '@/components/marketing/typography';
import {
	SITE_CARD_CLASS,
	SITE_COMPACT_SECTION_CLASS,
	SITE_EDITORIAL_RAIL_CLASS,
	SITE_SECTION_CLASS,
	SITE_STANDARD_RAIL_CLASS,
	SITE_UTILITY_HERO_CLASS,
} from '@/components/marketing/layout';

interface Props {
	// biome-ignore lint/suspicious/noExplicitAny: content collection entry
	entry: any;
	image?: { src: string; width: number; height: number } | null;
	section: 'blog' | 'changelog';
}

const { entry, image, section } = Astro.props;
const { Content, headings } = await render(entry);

const { title, description } = entry.data as unknown as { title: string; description: string };

// Technical deep-dives get a table of contents. Every article keeps the shared
// editorial rail so blog and changelog reading measures stay consistent.
const isTechnical = entry.data.category === 'technical';
const tocHeadings = isTechnical ? headings.filter((h) => h.depth === 2 || h.depth === 3) : [];
const showToc = tocHeadings.length >= 2;

// "Read next" pulls from the same section the reader is currently in.
const readNextBase = section === 'changelog' ? '/changelog/' : '/blog/';
const allPosts = await getCollection('posts');
const otherArticles = allPosts
	.filter(
		(p) =>
			p.id !== entry.id &&
			!p.data.unpublished &&
			(section === 'changelog' ? p.data.category === 'changelog' : p.data.category !== 'changelog'),
	)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
	.slice(0, 3)
	.map((post) => {
		const data = post.data as unknown as { title: string };
		return {
			slug: post.id.replace(/\/page$/, ''),
			title: data.title,
			category: { ...CATEGORIES[post.data.category], id: post.data.category },
			published: post.data.published,
			image: getPostImage(post),
		};
	});
---

<main id="main-content" tabindex="-1" class="blog-article relative w-full" style="--header-height: 5rem;">
	<article>
		<header class={SITE_UTILITY_HERO_CLASS}>
			<div class={SITE_EDITORIAL_RAIL_CLASS}>
				<a
					href="/blog/"
					data-site-reveal
					class="group flex items-center gap-2 text-sm text-ink-faint transition-colors hover:text-ink"
				>
					<Icon icon={faArrowLeft} className="h-3 w-auto transition-transform group-hover:-translate-x-0.5" />
					Blog
				</a>

				<div class:list={['mt-8', image ? 'mb-12' : 'mb-0']} data-site-reveal data-site-reveal-delay="40">
					<time datetime={entry.data.published.toISOString()} class="text-xs text-ink-faint">
						{formatTimestamp(entry.data.published)}
					</time>
					<h1 class:list={[HERO_H1_CLASS, 'mt-2']}>{title}</h1>
					{description && <p class={SUBTITLE_CLASS}>{description}</p>}
				</div>

				{image && (
					<img
						src={image.src}
						data-site-reveal
						data-site-reveal-delay="80"
						alt={title}
						width={image.width}
						height={image.height}
						class="aspect-[2/1] w-full rounded-xl border border-ink/10 object-cover"
						loading="eager"
						decoding="async"
					/>
				)}
			</div>
		</header>

		<section class={SITE_SECTION_CLASS}>
			<div class:list={['mx-auto w-full', showToc ? 'max-w-[62rem] xl:max-w-[88rem]' : 'max-w-[50rem]']}>
				<div class:list={[showToc && 'xl:grid xl:grid-cols-[minmax(0,1fr)_minmax(0,50rem)_minmax(0,1fr)] xl:gap-10']}>
					{showToc && <div class="hidden xl:block" aria-hidden="true" />}
					<div class={SITE_EDITORIAL_RAIL_CLASS}>
						{showToc && (
							<nav aria-label="Table of contents" class="mb-12 xl:hidden">
								<h2 class="text-sm font-medium text-ink-faint">In this post</h2>
								<ul class="mt-4 border-l border-ink/10 text-sm leading-snug">
									{tocHeadings.map((heading) => (
										<li>
											<a
												href={`#${heading.slug}`}
												class:list={[
													'block py-1 text-ink-faint transition-colors hover:text-ink',
													heading.depth === 3 ? 'pl-7' : 'pl-4',
												]}
											>
												{heading.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						)}

						<Prose as="div" surface="paper" className="blog-prose w-full max-w-none">
							<Content components={mdxComponents} />
						</Prose>

						<div class="mt-16 border-t border-ink/10 pt-8">
							<ArticleSocials title={title} client:load />
						</div>
					</div>

					{showToc && (
						<aside class="hidden xl:block">
							<nav
								data-blog-toc
								aria-label="Table of contents"
								class="sticky top-32 max-h-[calc(100vh-10rem)] overflow-y-auto"
							>
								<h2 class="text-sm font-medium text-ink-faint">In this post</h2>
								<ul class="mt-4 border-l border-ink/10 text-sm leading-snug">
									{tocHeadings.map((heading) => (
										<li>
											<a
												href={`#${heading.slug}`}
												data-toc-link
												class:list={[
													'-ml-px block border-l border-transparent py-1 text-ink-faint transition-colors hover:text-ink',
													heading.depth === 3 ? 'pl-7' : 'pl-4',
												]}
											>
												{heading.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						</aside>
					)}
				</div>
			</div>
		</section>
	</article>

	{otherArticles.length > 0 && (
		<section class={SITE_COMPACT_SECTION_CLASS}>
			<div class={SITE_STANDARD_RAIL_CLASS}>
				<h2 class={SECTION_H2_CLASS} data-site-reveal>Read next</h2>
				<div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3" data-site-reveal-group>
					{otherArticles.map((article) => (
						<a
							href={`${readNextBase}${article.slug}/`}
							data-site-reveal-child
							class:list={[SITE_CARD_CLASS, 'group flex flex-col transition-colors hover:border-ink/25']}
						>
							{article.image && (
								<img
									src={article.image.src}
									alt={article.title}
									width={600}
									height={300}
									class="aspect-[2/1] w-full rounded-xl border border-ink/10 object-cover transition-colors group-hover:border-ink/25"
									loading="lazy"
									decoding="async"
								/>
							)}
							<div class="mt-3 flex items-center gap-x-3 text-xs">
								<span class="text-xs font-medium text-ink-faint">{article.category.name}</span>
								<time datetime={article.published.toISOString()} class="text-ink-faint">
									{formatTimestamp(article.published)}
								</time>
							</div>
							<h3 class:list={[CARD_TITLE_CLASS, 'mt-2 transition-colors group-hover:text-pine']}>
								{article.title}
							</h3>
							<span class="mt-2 inline-flex items-center gap-1.5 text-xs font-medium text-ink-faint transition-colors group-hover:text-ink">
								Read article
								<Icon icon={faArrowRight} className="h-2.5 w-auto transition-transform group-hover:translate-x-0.5" />
							</span>
						</a>
					))}
				</div>
			</div>
		</section>
	)}
</main>

<style is:global>
	/* Editorial typography scoped to blog + changelog articles only, so docs Prose stays untouched. */
	.blog-article .blog-prose {
		font-size: 15px;
		line-height: 1.75;
		color: #56524a;
	}

	.blog-article .blog-prose p,
	.blog-article .blog-prose ul,
	.blog-article .blog-prose ol {
		margin-top: 1.4em;
		margin-bottom: 1.4em;
	}

	.blog-article .blog-prose > :first-child {
		margin-top: 0;
	}

	.blog-article .blog-prose h2 {
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.015em;
		margin-top: 2.75rem;
		margin-bottom: 1rem;
		color: #1b1916;
	}

	.blog-article .blog-prose h3 {
		font-size: 1.25rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.015em;
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
		color: #1b1916;
	}

	.blog-article .blog-prose h4 {
		font-size: 1.125rem;
		font-weight: 500;
		margin-top: 2rem;
		margin-bottom: 0.5rem;
		color: #1b1916;
	}

	.blog-article .blog-prose a:not(.not-prose) {
		color: #2e4034;
		text-decoration: underline;
		text-decoration-color: rgb(46 64 52 / 0.35);
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
		font-weight: 500;
		transition: text-decoration-color 0.15s ease, color 0.15s ease;
	}

	.blog-article .blog-prose a:not(.not-prose):hover {
		color: #1b1916;
		text-decoration-color: rgb(46 64 52 / 0.9);
	}

	.blog-article .blog-prose strong {
		color: #1b1916;
		font-weight: 600;
	}

	/* A bolded Markdown link (`**[text](url)**`) renders as <strong><a>. The
	   link rule above sets the <a> to 500, overriding the <strong>'s 600, so
	   without this the bolded link looks lighter than surrounding bold text. */
	.blog-article .blog-prose strong a:not(.not-prose) {
		font-weight: 600;
	}

	.blog-article .blog-prose :not(pre) > code {
		background: rgb(27 25 22 / 0.05);
		border: 1px solid rgb(27 25 22 / 0.1);
		border-radius: 0.375rem;
		padding: 0.1em 0.4em;
		font-size: 0.875em;
		color: #1b1916;
	}

	.blog-article .blog-prose pre {
		border-radius: 0.75rem;
		border: 1px solid rgb(27 25 22 / 0.2);
		background: #1b1916;
		padding: 1.25rem 1.4rem;
		font-size: 0.9rem;
		line-height: 1.7;
		margin-top: 1.75rem;
		margin-bottom: 1.75rem;
	}

	.blog-article .blog-prose blockquote {
		border-left: 2px solid #2e4034;
		padding-left: 1.25rem;
		font-style: normal;
		color: #56524a;
	}

	.blog-article .blog-prose img,
	.blog-article .blog-prose video {
		border-radius: 0.75rem;
		border: 1px solid rgb(27 25 22 / 0.1);
		margin-top: 2rem;
		margin-bottom: 2rem;
	}

	.blog-article .blog-prose hr {
		border-color: rgb(27 25 22 / 0.1);
		margin-top: 2.75rem;
		margin-bottom: 2.75rem;
	}

	.blog-article .blog-prose ul,
	.blog-article .blog-prose ol {
		padding-left: 1.4em;
	}

	.blog-article .blog-prose ul {
		list-style-type: disc;
	}

	.blog-article .blog-prose ol {
		list-style-type: decimal;
	}

	.blog-article .blog-prose li {
		margin-top: 0.4em;
		margin-bottom: 0.4em;
	}

	.blog-article .blog-prose li::marker {
		color: #1b1916;
	}

	.blog-article .blog-prose h2 a:not(.not-prose),
	.blog-article .blog-prose h3 a:not(.not-prose),
	.blog-article .blog-prose h4 a:not(.not-prose) {
		color: inherit;
		text-decoration: none;
	}

	.blog-article .blog-prose table {
		width: 100%;
		border-collapse: collapse;
		margin-top: 1.75rem;
		margin-bottom: 1.75rem;
		font-size: 0.9rem;
	}

	.blog-article .blog-prose th,
	.blog-article .blog-prose td {
		border: 1px solid rgb(27 25 22 / 0.1);
		padding: 0.5rem 0.75rem;
		text-align: left;
		color: #1b1916;
	}

	.blog-article .blog-prose th {
		font-weight: 600;
		background-color: rgb(27 25 22 / 0.03);
	}

	/* Active TOC entry, driven by the IntersectionObserver script below. */
	.blog-article [data-toc-link][data-active='true'] {
		border-color: #2e4034;
		color: #2e4034;
		font-weight: 500;
	}

	@media (min-width: 768px) {
		.blog-article .blog-prose h2 {
			font-size: 2rem;
		}
	}
</style>

<script>
	// Highlight the TOC entry for the section currently in view. Only technical
	// posts render [data-blog-toc], so this is a no-op on other categories.
	const toc = document.querySelector('[data-blog-toc]');
	if (toc) {
		const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]'));
		const headings = links
			.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
			.filter((el): el is HTMLElement => el !== null);

		const setActive = (id: string) => {
			for (const link of links) {
				link.dataset.active = String(decodeURIComponent(link.hash.slice(1)) === id);
			}
		};

		// The observed band stretches from far above the viewport down to 40% of
		// its height, so a heading "intersects" once it rises above the reading
		// line. The active section is the last such heading in document order.
		// Crossing the line in either direction fires the observer, including on
		// instant jumps from anchor links.
		const above = new Set<string>();
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) above.add(entry.target.id);
					else above.delete(entry.target.id);
				}
				let current = '';
				for (const heading of headings) {
					if (above.has(heading.id)) current = heading.id;
				}
				setActive(current);
			},
			{ rootMargin: '100000px 0px -60% 0px' },
		);
		for (const heading of headings) observer.observe(heading);
	}
</script>
