---
// Dynamic Apps overview. The Apps section is the page: its heading, features,
// and code visualization are the hero.
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { AppsHero, APPS_CODE } from '@/components/marketing/dynamic-apps/AppsHero';
import { RedesignedCTA } from '@/components/marketing/sections/RedesignedCTA';
import { highlightCodeHtml } from '@/lib/highlight-code';

const appsHighlightedCode = await highlightCodeHtml(APPS_CODE, 'typescript');
---

<MarketingLayout
	productId="dynamic-apps"
	tabId="overview"
	active="product"
	title="Dynamic Apps - Rivet"
	description="Deploy an AI-generated backend for every user, as isolated durable instances."
>
	<main class="paper-grain font-sans text-ink-soft">
		<AppsHero
			highlightedCode={appsHighlightedCode}
			docsHref="/dynamic-apps/docs"
			client:load
		/>
		<RedesignedCTA client:visible />
	</main>
</MarketingLayout>
