---
// Dynamic Apps overview: deploy the apps agents build, chaptered like
// /workflows. Composability, observability, and develop-locally each get a
// named chapter.
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { SetupWithAgentButton } from '@/components/marketing/SetupWithAgentButton';
import { AGENT_SETUP_PROMPTS } from '@/data/agentSetupPrompt';
import FaqJsonLd from '@/components/faq/FaqJsonLd.astro';
import { FaqList } from '@/components/faq/FaqSection';
import { ProductLockup } from '@/components/marketing/ProductLockup';
import { ProductMotif } from '@/components/marketing/ProductMotif';
import { ClosingCtaPanel } from '@/components/marketing/ClosingCtaPanel';
import { SectionRule } from '@/components/marketing/SectionRule';
import { DeploymentOptions } from '@/components/marketing/DeploymentOptions';
import { AppsVisualization, DEPLOY_CODE } from '@/components/marketing/dynamic-apps/AppsVisualization';
import { ArrowRight, CalendarClock, Database, FileCode2, Globe, Users, Workflow } from 'lucide-react';
import {
	AppsAnnotatedCode,
	type AnnotatedCodeRegion,
} from '@/components/marketing/dynamic-apps/AppsAnnotatedCode';
import {
	AppsIsolationDiagram,
	AppsRepairDiagram,
	AppsRoutingDiagram,
} from '@/components/marketing/diagrams/dynamicAppsDiagrams';
import {
	CAPTION_CLASS,
	CARD_TITLE_CLASS,
	INK_PANEL_GHOST_BUTTON_CLASS,
	INK_PANEL_LIGHT_BUTTON_CLASS,
	PRODUCT_HERO_CTA_ROW_CLASS,
	PRODUCT_HERO_H1_CLASS,
	PRODUCT_HERO_INNER_CLASS,
	PRODUCT_HERO_PRIMARY_BUTTON_CLASS,
	PRODUCT_HERO_SECTION_CLASS,
	PRODUCT_HERO_SUBTITLE_CLASS,
	SECTION_H2_CLASS,
	SECTION_LEDE_CLASS,
} from '@/components/marketing/typography';
import { productLogos } from '@/sitemap/productLogos';
import { wordmarkMaskStyle } from '@/lib/product-accent';
import { dynamicAppsFaqs } from '@/data/faqs/dynamic-apps';
import { highlightCodeHtml } from '@/lib/highlight-code';
import { getProduct } from '@/sitemap/products';
import { SITE_CARD_CLASS, SITE_COMPACT_SECTION_CLASS, SITE_NARROW_RAIL_CLASS, SITE_SECTION_CLASS } from '@/components/marketing/layout';

const APPS_EXAMPLE_ROOT = 'https://github.com/rivet-dev/dynamic-apps/blob/main/examples';
const AI_BUILDER_EXAMPLE_URL =
	'https://github.com/rivet-dev/dynamic-apps/tree/main/examples/apps-ai-builder';
const INSPECTOR_IMAGE =
	'https://assets.rivet.dev/repo/website/src/components/marketing/images/screenshots/rivet-actor-inspector.png';
const INSTALL_COMMAND = 'npm add @rivet-dev/dynamic-apps';

// Dynamic Apps snippets live in the agentOS repo (`snippetFrom: "agentos"`).
const dynamicAppsProduct = getProduct('dynamic-apps');

if (!dynamicAppsProduct) {
	throw new Error('Missing Dynamic Apps product metadata');
}

const deployCodeHtml = await highlightCodeHtml(DEPLOY_CODE, 'typescript');

// Chapter 01: the whole loop as one file, split into labeled regions.
const APPS_SERVER_SOURCE_URL = 'https://github.com/rivet-dev/dynamic-apps/tree/main/examples/apps-hello-world';

async function codeRegion(input: { label?: string; note?: string; code: string }): Promise<AnnotatedCodeRegion> {
	return {
		label: input.label,
		note: input.note,
		html: await highlightCodeHtml(input.code, 'typescript'),
	};
}

const appsRegions = await Promise.all([
	codeRegion({
		label: 'Generate',
		note: 'An LLM writes the app as a set of files. Any model, any framework.',
		code: `import { anthropic } from "@ai-sdk/anthropic";
import { generateObject } from "ai";
import { z } from "zod";

const { object } = await generateObject({
  model: anthropic("claude-sonnet-5"),
  schema: z.object({ files: z.record(z.string(), z.string()) }),
  prompt: "Build a team board as a complete web app.",
});`,
	}),
	codeRegion({
		label: 'Deploy',
		note: 'One call builds the files and releases them as an isolated instance.',
		code: `import { deployApp } from "@rivet-dev/dynamic-apps";

await deployApp({
  appId: "pied-piper",
  files: object.files,
});`,
	}),
	codeRegion({
		label: 'Route',
		note: 'Your Hono server serves every deployed app at /apps/:appId.',
		code: `import { serve } from "@hono/node-server";
import { appsRouter } from "@rivet-dev/dynamic-apps";
import { Hono } from "hono";

const server = new Hono();
server.route("/apps", appsRouter);

serve({ fetch: server.fetch, port: 3000 });`,
	}),
]);

// What every deployed app gets from running as its own isolated instance.
const appIsolation = [
	{
		title: 'An app per user',
		body: 'Address each app by ID. Every user, tenant, or session gets a deployment of its own.',
	},
	{
		title: 'Isolated by default',
		body: 'Each app runs in its own agentOS VM. Tenants share no filesystem, memory, or crashes.',
	},
	{
		title: 'Scales to zero',
		body: 'A running app takes 22 MB of memory. An idle one takes none.',
	},
	{
		title: 'Full Node.js',
		body: 'Powered by agentOS with a secure Node.js runtime, so generated apps can use any npm package.',
	},
];

const appCapabilities = [
	{
		title: 'Backends & REST APIs',
		icon: Globe,
		body: 'Serve HTTP APIs from a generated app with any Node.js framework.',
		href: '/dynamic-apps/docs/backends/',
	},
	{
		title: 'Frontends & Static Sites',
		icon: FileCode2,
		body: 'Serve generated interfaces and directories with an index.html directly.',
		href: '/dynamic-apps/docs/static-websites/',
	},
	{
		title: 'SQLite',
		icon: Database,
		body: 'Store durable relational data in an actor-owned SQLite database.',
		href: '/dynamic-apps/docs/sqlite/',
	},
	{
		title: 'Workflows & queues',
		icon: Workflow,
		body: 'Run durable jobs that sleep, retry, and resume, plus ordered queue processing.',
		href: '/dynamic-apps/docs/workflows/',
	},
	{
		title: 'Crons & schedules',
		icon: CalendarClock,
		body: 'Schedule recurring work that runs even while the app is idle.',
		href: '/dynamic-apps/docs/workflows/',
	},
	{
		title: 'Multiplayer',
		icon: Users,
		body: 'Share realtime state between every user connected to an app.',
		href: '/dynamic-apps/docs/multiplayer/',
	},
];

const observabilityCapabilities = [
	{
		title: 'SQLite viewer',
		body: "Browse and query each app's SQLite data in realtime, across every deployment.",
	},
	{
		title: 'Workflow state',
		body: 'Inspect the progress, steps, and retries of jobs running inside an app.',
	},
	{
		title: 'Event monitoring',
		body: 'Follow actions, connection events, and application logs while an app serves traffic.',
	},
	{
		title: 'REPL',
		body: 'Debug a live app by calling its actions and subscribing to its events from the dashboard.',
	},
];

const compositionLayers = [
	{
		name: 'Actors',
		logo: productLogos.actors.src,
		body: 'Every deployed app runs as Rivet Actors, which provide identity, durable state, queues, and scale to zero.',
		href: '/actors/',
	},
	{
		name: 'agentOS',
		logo: productLogos.agentos.src,
		body: 'Builds and serves each app in an agentOS VM with files, processes, and networking.',
		href: '/agentos/',
	},
	{
		name: 'Workflows',
		logo: productLogos.workflows.src,
		body: 'Adds recorded steps, retries, and replay when a generated app runs multi-step work.',
		href: '/workflows/',
	},
];
---

<MarketingLayout
	productId="dynamic-apps"
	tabId="overview"
	active="product"
	title="Dynamic Apps: deploy AI-generated apps for your users"
	description="Deploy AI-generated apps as isolated, durable instances. Each app scales to zero at 22 MB, wakes on demand, and runs on your infrastructure or Rivet Cloud."
	canonicalUrl="https://rivet.dev/dynamic-apps/"
	ogImage="https://assets.rivet.dev/website/public/promo/og/dynamic-apps.png"
	keywords={[
		'AI-generated apps',
		'AI app deployment',
		'deploy generated code',
		'per-user backends',
		'multi-tenant isolation',
		'scale to zero',
		'agentOS',
		'open source infrastructure',
	]}
>
	<FaqJsonLd items={dynamicAppsFaqs} />

	<main id="main-content" tabindex="-1">
		<!-- Hero -->
		<section class={PRODUCT_HERO_SECTION_CLASS}>
			<ProductMotif productId="dynamic-apps" surface="hero" />
			<div class="relative z-10 mx-auto w-full max-w-7xl">
				<div class={PRODUCT_HERO_INNER_CLASS}>
					<div class="mb-7 flex" data-site-reveal data-site-reveal-delay="40">
						<ProductLockup product={dynamicAppsProduct} />
					</div>
					<h1 class={PRODUCT_HERO_H1_CLASS} data-site-reveal data-site-reveal-delay="80">Deploy AI-generated apps for your users.</h1>
					<p class={PRODUCT_HERO_SUBTITLE_CLASS} data-site-reveal data-site-reveal-delay="120">
						22 MB of memory while serving, zero while idle. Deploy on any cloud. Supports frontends, REST APIs, multiplayer, SQLite, workflows, and more.
					</p>
					<div class={PRODUCT_HERO_CTA_ROW_CLASS} data-site-reveal data-site-reveal-delay="160">
						<button
							type="button"
							data-dynamic-apps-install-copy
							aria-label={`Copy ${INSTALL_COMMAND}`}
							class="group relative flex w-full items-center justify-center gap-2.5 rounded-md border border-ink/15 bg-white/55 px-3.5 py-2.5 font-mono text-[11px] text-ink-soft transition-colors motion-reduce:transition-none hover:border-ink/30 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine/60 focus-visible:ring-offset-2 focus-visible:ring-offset-paper sm:w-auto sm:text-[13px]"
						>
							<span aria-hidden="true" class="select-none text-pine">$</span>
							<span class="whitespace-nowrap">{INSTALL_COMMAND}</span>
							<span data-dynamic-apps-copy-feedback aria-live="polite" class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded bg-ink px-2 py-1 font-sans text-xs text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">Copy</span>
						</button>
						<noscript>
							<style is:inline>
								[data-dynamic-apps-install-copy] { display: none !important; }
							</style>
							<code class="flex w-full select-all items-center justify-center gap-2.5 rounded-md border border-ink/15 bg-white/55 px-3.5 py-2.5 font-mono text-[11px] text-ink-soft sm:w-auto sm:text-[13px]"><span aria-hidden="true" class="text-pine">$</span> {INSTALL_COMMAND}</code>
						</noscript>
						<SetupWithAgentButton prompt={AGENT_SETUP_PROMPTS['dynamic-apps']} client:load />
					</div>
				</div>

				<div class="mx-auto mt-14 max-w-5xl md:mt-20">
					<AppsVisualization deployCodeHtml={deployCodeHtml} />
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Chapter 01: the whole loop in code -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto max-w-7xl">
				<div class="grid gap-10 lg:grid-cols-[5fr_7fr] lg:items-start lg:gap-16">
					<div data-site-reveal>
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Runs in your backend, not another SaaS.</h2>
						<p class={SECTION_LEDE_CLASS}>
							A library, not a platform. It serves the apps your users generate alongside the rest of your API, so you keep full control over routing, auth, and data.
						</p>
					</div>
					<div class="grid gap-4 sm:grid-cols-2" data-site-reveal-group>
						{appIsolation.map((item) => (
							<div class={SITE_CARD_CLASS} data-site-reveal-child>
								<h3 class={CARD_TITLE_CLASS}>{item.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.body}</p>
							</div>
						))}
					</div>
				</div>
				<div class="mt-12 min-w-0 md:mt-16" data-site-reveal>
					<AppsAnnotatedCode regions={appsRegions} documentationUrl="/dynamic-apps/docs/deploy/" sourceUrl={APPS_SERVER_SOURCE_URL} />
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Chapter 02: what a generated app can contain -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto max-w-7xl">
				<div class="max-w-3xl" data-site-reveal>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Comes with the infrastructure real apps need.</h2>
					<p class={SECTION_LEDE_CLASS}>
						Every generated app gets durable SQLite, background jobs, cron, and realtime out of the box. Nothing extra for you to provision.
					</p>
				</div>
				<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-site-reveal-group>
					{appCapabilities.map((item) => {
						const Icon = item.icon;
						return (
							<a
								href={item.href}
								class={`group block cursor-pointer transition-colors duration-200 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine/50 motion-reduce:transition-none ${SITE_CARD_CLASS}`}
								data-site-reveal-child
							>
								<span class="flex items-center gap-3">
									<Icon className="h-5 w-5 text-ink-soft transition-colors group-hover:text-ink" />
									<span class={CARD_TITLE_CLASS}>{item.title}</span>
									<ArrowRight className="ml-auto h-4 w-4 -translate-x-1 text-ink-faint opacity-0 transition-[opacity,transform,color] duration-200 group-hover:translate-x-0 group-hover:text-ink-soft group-hover:opacity-100 motion-reduce:transition-none" />
								</span>
								<span class="mt-4 block text-[15px] leading-relaxed text-ink-soft transition-colors group-hover:text-ink">{item.body}</span>
							</a>
						);
					})}
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Chapter 03: routing through your server -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-16">
				<div data-site-reveal>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Your server, your rules.</h2>
					<p class={SECTION_LEDE_CLASS}>
						Requests reach your Node.js backend first, so your routing, middleware, and auth apply. The apps router then hands each request to the <a class="text-pine caption-underline" href="/agentos/">agentOS</a> VM running that app, in the same process. No extra hop.
					</p>
					<p class={SECTION_LEDE_CLASS}>
						Read about
						<a class="text-pine caption-underline" href="/dynamic-apps/docs/routing/">routing</a>,
						<a class="text-pine caption-underline" href="/dynamic-apps/docs/authentication/">authentication</a>, and
						<a class="text-pine caption-underline" href="/dynamic-apps/docs/deploy/">deploying apps</a>.
					</p>
				</div>
				<div class="min-w-0">
					<AppsRoutingDiagram client:visible />
					<noscript>
						<p class={`mt-4 ${CAPTION_CLASS}`}>The diagram shows a request entering your Node.js backend, passing your middleware and auth, then the apps router handing it to the agentOS VM running that app.</p>
					</noscript>
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Chapter 04: the repair loop -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-16">
				<div data-site-reveal>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Broken builds never ship.</h2>
					<p class={SECTION_LEDE_CLASS}>
						A failed build returns TypeScript diagnostics the agent uses to repair the files and deploy again. The active release keeps serving the whole time.
					</p>
					<p class={SECTION_LEDE_CLASS}>
						Read about
						<a class="text-pine caption-underline" href="/dynamic-apps/docs/deploy/">deploying apps</a> or view the
						<a class="text-pine caption-underline" href={AI_BUILDER_EXAMPLE_URL}>AI App Builder example</a>.
					</p>
				</div>
				<div class="min-w-0">
					<AppsRepairDiagram client:visible />
					<noscript>
						<p class={`mt-4 ${CAPTION_CLASS}`}>The diagram shows generate, build, and release, with failed builds feeding their type errors back into generate. The previous release keeps serving until a build succeeds.</p>
					</noscript>
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Chapter 05: isolation for building and serving -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-16">
				<div data-site-reveal>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Full isolation, powered by V8 and WebAssembly.</h2>
					<p class={SECTION_LEDE_CLASS}>
						Every app builds and serves inside its own <a class="text-pine caption-underline" href="/agentos/">agentOS</a> sandbox: a V8 isolate for the JavaScript, WebAssembly for the Linux-like environment around it. The same boundary applies while a build runs and while requests are served.
					</p>
					<p class={SECTION_LEDE_CLASS}>
						Read about the
						<a class="text-pine caption-underline" href="/agentos/docs/security-model/">agentOS security model</a> and
						<a class="text-pine caption-underline" href="/agentos/docs/resource-limits/">resource limits</a>.
					</p>
				</div>
				<div class="min-w-0">
					<AppsIsolationDiagram client:visible />
					<noscript>
						<p class={`mt-4 ${CAPTION_CLASS}`}>The diagram shows two agentOS sandboxes, one building the generated files and one serving requests, each a V8 isolate with WebAssembly, resource limits, and no host access.</p>
					</noscript>
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Observability -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto max-w-7xl">
				<div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
					<div data-site-reveal>
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>See inside every app.</h2>
						<p class={SECTION_LEDE_CLASS}>
							Deployed apps run as Rivet Actors, so the dashboard shows their data, jobs, events, and actions live.
						</p>
					</div>
					<div class="grid gap-4 sm:grid-cols-2" data-site-reveal-group>
						{observabilityCapabilities.map((capability) => (
							<div class={SITE_CARD_CLASS} data-site-reveal-child>
								<h3 class={CARD_TITLE_CLASS}>{capability.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink-soft">{capability.body}</p>
							</div>
						))}
					</div>
				</div>

				<figure class="mt-12 overflow-hidden rounded-xl" data-site-reveal>
					<img
						src={INSPECTOR_IMAGE}
						alt="Rivet dashboard inspecting a deployed app, showing Actor state, events, and callable actions"
						width="2688"
						height="2018"
						loading="lazy"
						class="block h-auto w-full"
					/>
				</figure>
			</div>
		</section>

		<SectionRule />

		<!-- Composition -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto max-w-7xl">
				<div class="max-w-3xl" data-site-reveal>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>One stack under every app.</h2>
				</div>

				<div class="mt-12 grid overflow-hidden rounded-xl border-l border-t border-ink/10 md:grid-cols-3" data-site-reveal-group>
					{compositionLayers.map((layer) => (
						<a href={layer.href} class="group flex min-h-64 flex-col border-b border-r border-ink/10 bg-white/55 p-6 transition-colors motion-reduce:transition-none hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-pine md:p-8" data-site-reveal-child>
							<div class="flex items-center gap-3">
								<span
									aria-hidden="true"
									class="flex size-9 shrink-0 items-center justify-center rounded-[34.375%] bg-ink"
								>
									<span style={wordmarkMaskStyle(layer.logo)} class="block h-full w-full bg-white"></span>
								</span>
								<h3 class="text-xl font-medium tracking-[-0.01em] text-ink">{layer.name}</h3>
							</div>
							<p class="mt-5 flex-1 text-[15px] leading-relaxed text-ink-soft">{layer.body}</p>
							<span class="mt-7 text-sm font-medium text-pine transition-colors group-hover:text-ink">Product overview <span aria-hidden="true">→</span></span>
						</a>
					))}
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Deployment -->
		<section class={`${SITE_SECTION_CLASS}`}>
			<div class="mx-auto max-w-7xl">
				<div class="mb-12 max-w-3xl" data-site-reveal>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Develop locally. Deploy your way.</h2>
					<p class={SECTION_LEDE_CLASS}>
						Dynamic Apps is a library, not a hosted platform. Run it anywhere and customize the server, routing, authentication, and deployment flow.
					</p>
				</div>
				<div data-site-reveal>
					<DeploymentOptions
						productName="Dynamic Apps"
						quickstartHref="/dynamic-apps/docs/quickstart"
						selfHostHref="/dynamic-apps/self-host/control-plane"
						installCommand={INSTALL_COMMAND}
					/>
				</div>
			</div>
		</section>

		<SectionRule />

		<section class={`${SITE_COMPACT_SECTION_CLASS}`} aria-labelledby="dynamic-apps-faq-heading">
			<div class={SITE_NARROW_RAIL_CLASS}>
				<h2 id="dynamic-apps-faq-heading" class={`mb-12 text-center text-balance ${SECTION_H2_CLASS}`} data-site-reveal>Frequently asked questions</h2>
				<div data-site-reveal>
					<FaqList items={dynamicAppsFaqs} theme="light" client:visible />
				</div>
			</div>
		</section>

		<SectionRule />

		<!-- Closing CTA: the hero owns this page's single ember action. -->
		<ClosingCtaPanel
			title="An app for every user."
			description="Deploy isolated, durable instances for the software your agents generate. They scale to zero and wake on demand."
		>
			<a href="/dynamic-apps/docs/" class={INK_PANEL_LIGHT_BUTTON_CLASS}>Documentation</a>
			<a href="/talk-to-an-engineer/" class={INK_PANEL_GHOST_BUTTON_CLASS}>Talk to an engineer</a>
		</ClosingCtaPanel>
	</main>
</MarketingLayout>

<script>
	function bindDynamicAppsInstallCopy() {
		document.querySelectorAll('[data-dynamic-apps-install-copy]').forEach((element) => {
			if (!(element instanceof HTMLButtonElement) || element.dataset.copyBound === 'true') return;
			element.dataset.copyBound = 'true';
			const feedback = element.querySelector('[data-dynamic-apps-copy-feedback]');
			element.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText('npm add @rivet-dev/dynamic-apps');
					element.setAttribute('aria-label', 'Install command copied');
					if (feedback instanceof HTMLElement) {
						feedback.textContent = 'Copied';
						feedback.classList.remove('opacity-0');
						feedback.classList.add('opacity-100');
					}
					window.setTimeout(() => {
						element.setAttribute('aria-label', 'Copy npm add @rivet-dev/dynamic-apps');
						if (feedback instanceof HTMLElement) {
							feedback.textContent = 'Copy';
							feedback.classList.remove('opacity-100');
							feedback.classList.add('opacity-0');
						}
					}, 2_000);
				} catch {
					if (feedback instanceof HTMLElement) {
						feedback.textContent = 'Select and copy';
						feedback.classList.remove('opacity-0');
						feedback.classList.add('opacity-100');
						window.setTimeout(() => {
							feedback.textContent = 'Copy';
							feedback.classList.remove('opacity-100');
							feedback.classList.add('opacity-0');
						}, 2_000);
					}
				}
			});
		});
	}

	bindDynamicAppsInstallCopy();
	document.addEventListener('astro:page-load', bindDynamicAppsInstallCopy);
</script>
