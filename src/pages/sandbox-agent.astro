---
// Preserve the original Sandbox Agent landing page, as with Secure Exec.
// Only the surrounding navigation/footer and relocated links change.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Header } from '@/components/v2/Header';
import { Hero } from '@/components/marketing/sandbox-agent/Hero';
import { PainPoints } from '@/components/marketing/sandbox-agent/PainPoints';
import { FeatureGrid } from '@/components/marketing/sandbox-agent/FeatureGrid';
import { GetStarted } from '@/components/marketing/sandbox-agent/GetStarted';
import { Inspector } from '@/components/marketing/sandbox-agent/Inspector';
import { FAQ } from '@/components/marketing/sandbox-agent/FAQ';
import '@/components/marketing/sandbox-agent/sandbox-agent.css';
---

<BaseLayout
  title="Sandbox Agent SDK - Run Coding Agents in Sandboxes"
  description="Universal SDK for coding agents. Control Claude Code, Codex, OpenCode, Amp, and Pi with unified events and sessions."
  canonicalUrl="https://rivet.dev/sandbox-agent/"
  ogImage="/sandbox-agent/og.png"
  pageFamily="site"
  themeColor="#09090b"
  darkChrome
>
  <Fragment slot="head-fonts">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </Fragment>
  <Header
    variant="full-width"
    light={false}
    showProductBar={true}
    productId="sandbox-agent"
    tabId="overview"
    initialPathname={Astro.url.pathname}
    active="product"
    pageFamily="site"
    client:load
  />
  <div class="sandbox-agent-page min-h-screen overflow-x-clip">
    <main id="main-content" tabindex="-1">
      <Hero client:load />
      <PainPoints client:visible />
      <FeatureGrid client:visible />
      <GetStarted client:visible />
      <Inspector client:visible />
      <FAQ client:visible />
    </main>
  </div>
</BaseLayout>
