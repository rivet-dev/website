---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PricingPageClient from '@/components/marketing/pricing/PricingPageClient';
import FaqJsonLd from '@/components/faq/FaqJsonLd.astro';
import { FaqSection } from '@/components/faq/FaqSection';
import { ClosingCtaPanel } from '@/components/marketing/ClosingCtaPanel';
import { SectionRule } from '@/components/marketing/SectionRule';
import {
	INK_PANEL_GHOST_BUTTON_CLASS,
	INK_PANEL_LIGHT_BUTTON_CLASS,
} from '@/components/marketing/typography';
import { ProductLockup } from '@/components/marketing/ProductLockup';
import {
	PRODUCT_HERO_H1_CLASS,
	PRODUCT_HERO_INNER_CLASS,
	PRODUCT_HERO_SECTION_CLASS,
	PRODUCT_HERO_SUBTITLE_CLASS,
} from '@/components/marketing/typography';
import { getProduct } from '@/sitemap/products';
import { ogImageFor } from '@/lib/ogImage';
import { cloudFaqs } from '@/data/faqs/cloud';

const cloudProduct = getProduct('cloud');

if (!cloudProduct) {
	throw new Error('Missing Cloud product metadata');
}

// Product schema with pricing tiers
const productSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	"name": "Rivet Cloud",
	"description": "Managed control plane for stateful backends, with Actor routing, persistence, and operational tooling.",
	"brand": {
		"@type": "Brand",
		"name": "Rivet"
	},
	"url": "https://rivet.dev/pricing/",
	"image": `https://rivet.dev${ogImageFor("cloud")}`,
	"category": "Cloud Computing Platform",
	"offers": [
		{
			"@type": "Offer",
			"name": "Free",
			"description": "For prototyping. One control plane node in one availability zone, up to 1 Actor Node included at no charge, community support.",
			"price": "0",
			"priceCurrency": "USD",
			"priceValidUntil": "2027-12-31",
			"availability": "https://schema.org/InStock",
			"url": "https://dashboard.rivet.dev"
		},
		{
			"@type": "Offer",
			"name": "Hobby",
			"description": "For side projects that need to stay up. One control plane node in one availability zone, up to 3 Actor Nodes, email support. Actor Nodes priced per node from $4.20/month.",
			"price": "10",
			"priceCurrency": "USD",
			"priceValidUntil": "2027-12-31",
			"availability": "https://schema.org/InStock",
			"url": "https://dashboard.rivet.dev"
		},
		{
			"@type": "Offer",
			"name": "Team",
			"description": "For production workloads and growing teams. Three control plane nodes across three availability zones, up to 10 Actor Nodes, Slack and email support. Actor Nodes priced per node from $4.20/month.",
			"price": "120",
			"priceCurrency": "USD",
			"priceValidUntil": "2027-12-31",
			"availability": "https://schema.org/InStock",
			"url": "https://dashboard.rivet.dev"
		},
		{
			"@type": "Offer",
			"name": "Enterprise",
			"description": "For compliance, SSO, audit logs, and dedicated support. Five control plane nodes across three availability zones, up to 50 Actor Nodes. Actor Nodes priced per node from $4.20/month.",
			"price": "900",
			"priceCurrency": "USD",
			"priceValidUntil": "2027-12-31",
			"availability": "https://schema.org/InStock",
			"url": "https://dashboard.rivet.dev"
		}
	]
};
---

<MarketingLayout
	active="pricing"
	title="Rivet Cloud Pricing - Rivet"
	description="Run Rivet on our managed cloud or inside your own VPC, customer environment, or air-gapped network. Transparent pricing for the agentic era."
	canonicalUrl="https://rivet.dev/pricing/"
	ogImage={ogImageFor('cloud')}
>
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
	<FaqJsonLd items={cloudFaqs} />
	<main id="main-content" tabindex="-1">
		<!-- Hero -->
		<section class={PRODUCT_HERO_SECTION_CLASS}>
			<div class={PRODUCT_HERO_INNER_CLASS} data-site-reveal-group data-site-reveal-stagger="40">
				<div class="mb-7 flex" data-site-reveal-child>
					<ProductLockup product={cloudProduct} />
				</div>
				<h1 class={PRODUCT_HERO_H1_CLASS} data-site-reveal-child>Simple, predictable pricing</h1>
				<p class={PRODUCT_HERO_SUBTITLE_CLASS} data-site-reveal-child>
					Pay for coordination, state, and active execution on Rivet Cloud. Self-host Rivet when you need your own infrastructure.
				</p>
			</div>
		</section>
		<SectionRule />
		<PricingPageClient client:load />
		<SectionRule />
		{/* Hydrated on scroll so the accordion animates; content is still SSR'd
		    into the HTML (and JSON-LD) for crawlers. */}
		<div data-site-reveal>
			<FaqSection items={cloudFaqs} theme="light" client:visible />
		</div>
		<SectionRule />
		<ClosingCtaPanel
			title="Infrastructure for the agentic era."
			description="Build with agents, build for agents, and run it where your data lives."
		>
			<a href="/docs/" class={INK_PANEL_LIGHT_BUTTON_CLASS}>Start Building</a>
			<a href="/talk-to-an-engineer/" class={INK_PANEL_GHOST_BUTTON_CLASS}>Talk to an Engineer</a>
		</ClosingCtaPanel>
	</main>
</MarketingLayout>
