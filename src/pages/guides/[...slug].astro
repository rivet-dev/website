---
// The Guides tab: /guides/{...slug}
//
//   src/content/docs/<bundle>/guides/**   each product bundle's guides
//   src/content/guides/index.mdx          website-owned overview
//
// All share the sidebar built by `guidesSidebar()` in src/sitemap/products.ts.
// The overview is website-owned because it is generated from that sidebar
// (`GuideCards`).
import { getCollection } from 'astro:content';
import { ogImageFor } from '@/lib/ogImage';
import DocsArticlePage from '@/components/docs/DocsArticlePage.astro';
import { createGuideCards } from '@/components/docs/GuideCards';
import { getContentParamSlug } from '@/lib/content-path';
import { getRouteSeoPolicy, robotsDirective } from '@/lib/routeSeoPolicy';
import { DOCS_SOURCES } from '@/sitemap/docs-sources';
import { GUIDES_ROUTE_PREFIX, GUIDES_SECTION, guideForContentId, guideHref } from '@/sitemap/guides';

export async function getStaticPaths() {
	// `getStaticPaths` is hoisted, so anything it uses must be declared inside.
	const GUIDES_OVERVIEW_ID = 'index';
	const paths = [];

	// Every guide's description, keyed by its site href, for the overview cards.
	const descriptions: Record<string, string | undefined> = {};
	// Guides from different bundles share one flat namespace.
	const owners = new Map<string, string>();

	for (const entry of await getCollection('docs')) {
		const guide = guideForContentId(entry.id);
		if (!guide) continue;
		const owner = owners.get(guide.slug);
		if (owner) {
			throw new Error(
				`/guides/${guide.slug}/ is defined by both the ${owner} and ${guide.bundle} bundles; rename one`,
			);
		}
		owners.set(guide.slug, guide.bundle);
		descriptions[guideHref(guide.slug)] = entry.data.description;

		const source = DOCS_SOURCES[guide.bundle];
		const contentPath = (entry.filePath ?? '').split(`/${guide.bundle}/${GUIDES_SECTION}/`).pop();
		paths.push({
			params: { slug: getContentParamSlug(guide.slug) },
			props: {
				entry,
				entryIdPrefix: `${guide.bundle}/${GUIDES_SECTION}/`,
				editUrlOverride: source.localBundle
					? `https://github.com/rivet-dev/website/edit/main/${source.localBundle}/docs/content/${GUIDES_SECTION}/${contentPath}`
					: `https://github.com/rivet-dev/${source.repo}/edit/main/${source.bundlePath ?? 'docs'}/content/${GUIDES_SECTION}/${contentPath}`,
			},
		});
	}

	const overview = (await getCollection('guides')).find((entry) => entry.id === GUIDES_OVERVIEW_ID);
	if (!overview) {
		throw new Error(`The Guides overview src/content/guides/${GUIDES_OVERVIEW_ID}.mdx is missing`);
	}
	paths.push({
		params: { slug: undefined },
		props: {
			entry: overview,
			entryIdPrefix: '',
			routeSlugOverride: '',
			editUrlOverride: `https://github.com/rivet-dev/website/edit/main/src/content/guides/${GUIDES_OVERVIEW_ID}.mdx`,
			descriptions,
		},
	});

	return paths;
}

const { entry, entryIdPrefix, routeSlugOverride, editUrlOverride, descriptions } = Astro.props;
const robots = robotsDirective(getRouteSeoPolicy(Astro.url));
---

<DocsArticlePage
	entry={entry}
	routePrefix={GUIDES_ROUTE_PREFIX}
	entryIdPrefix={entryIdPrefix}
	routeSlugOverride={routeSlugOverride}
	breadcrumbName="Guides"
	ogImage={ogImageFor('guides')}
	seoContextLabel="Rivet Guides"
	editUrlOverride={editUrlOverride}
	extraComponents={descriptions ? {
		GuideCards: createGuideCards({ overviewHref: guideHref(''), descriptions }),
	} : {}}
	robots={robots}
/>
