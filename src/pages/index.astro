---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { RedesignedHero } from '@/components/marketing/sections/RedesignedHero';
import { StackSection } from '@/components/marketing/sections/StackSection';
import { AgentStackSection } from '@/components/marketing/sections/AgentStackSection';
import { ObservabilitySection } from '@/components/marketing/sections/ObservabilitySection';
import { IntegrationsSection } from '@/components/marketing/sections/IntegrationsSection';
import { HostingSection } from '@/components/marketing/sections/HostingSection';
import { OnPremSection } from '@/components/marketing/sections/OnPremSection';
import { ClosingCtaPanel } from '@/components/marketing/ClosingCtaPanel';
import { SectionRule } from '@/components/marketing/SectionRule';
import { getPostImage } from '@/lib/postImage';
import {
	INK_PANEL_GHOST_BUTTON_CLASS,
	INK_PANEL_LIGHT_BUTTON_CLASS,
} from '@/components/marketing/typography';

// Import thinking images
const imgThinker = { src: "https://assets.rivet.dev/website/images/thinking/thinker-rodin-closeup.jpg", width: 2673, height: 3722, format: "jpg" };
const imgLadyWriting = { src: "https://assets.rivet.dev/website/images/thinking/a_lady_writing_1962.10.1.jpg", width: 3596, height: 4096, format: "jpg" };
const imgPortrait = { src: "https://assets.rivet.dev/website/images/thinking/portrait_of_a_man_possibly_jan_snoeck_1967.4.1.jpg", width: 3076, height: 4096, format: "jpg" };
const imgSaintMark = { src: "https://assets.rivet.dev/website/images/thinking/saint_mark_2012.79.1.jpg", width: 2187, height: 2679, format: "jpg" };
const imgVirginReading = { src: "https://assets.rivet.dev/website/images/thinking/the_virgin_reading_1939.1.354.jpg", width: 2658, height: 4096, format: "jpg" };
const imgThinkingOver = { src: "https://assets.rivet.dev/website/images/thinking/thinking_it_over_2008.115.5135.jpg", width: 2437, height: 3483, format: "jpg" };
const imgWomanBalance = { src: "https://assets.rivet.dev/website/images/thinking/woman_holding_a_balance_1942.9.97.jpg", width: 3620, height: 4096, format: "jpg" };
const imgThinking2 = { src: "https://assets.rivet.dev/website/images/thinking/thinking2.jpg", width: 455, height: 600, format: "jpg" };
const imgThinking3 = { src: "https://assets.rivet.dev/website/images/thinking/thinking3.jpg", width: 1160, height: 1017, format: "jpg" };
const imgThinking6 = { src: "https://assets.rivet.dev/website/images/thinking/thinking6.jpg", width: 1115, height: 808, format: "jpg" };
const img0000405625 = { src: "https://assets.rivet.dev/website/images/thinking/0000405625-og.jpg", width: 1282, height: 1453, format: "jpg" };
const imgCHSDM = { src: "https://assets.rivet.dev/website/images/thinking/CHSDM-1946-9-1MattFlynn.jpg", width: 1990, height: 1845, format: "jpg" };
const imgNPG = { src: "https://assets.rivet.dev/website/images/thinking/NPG-NPG_POB105.jpg", width: 3750, height: 3050, format: "jpg" };
const imgSAAM = { src: "https://assets.rivet.dev/website/images/thinking/SAAM-1912.2.1_1.jpg", width: 2523, height: 3000, format: "jpg" };
const imgThink = { src: "https://assets.rivet.dev/website/images/thinking/think.jpg", width: 2935, height: 3638, format: "jpg" };
const imgThink11 = { src: "https://assets.rivet.dev/website/images/thinking/think11.jpg", width: 665, height: 800, format: "jpg" };
const imgThink12 = { src: "https://assets.rivet.dev/website/images/thinking/think12.png", width: 2063, height: 1594, format: "png" };
const imgThinker6 = { src: "https://assets.rivet.dev/website/images/thinking/thinker6.jpg", width: 2523, height: 3347, format: "jpg" };
// Optimize all thinking images
const thinkingImageSources = [
	{ src: imgThinker, title: 'The Thinker', artist: 'Auguste Rodin', date: 'modeled 1880' },
	{ src: imgLadyWriting, title: 'A Lady Writing', artist: 'Johannes Vermeer', date: 'c. 1665' },
	{ src: imgPortrait, title: 'Portrait of a Man (Possibly Jan Snoeck)', artist: 'Jan Gossaert', date: 'c. 1530' },
	{ src: imgSaintMark, title: 'Saint Mark', artist: 'Giorgio Vasari', date: '1570/1571' },
	{ src: imgVirginReading, title: 'The Virgin Reading', artist: 'Vittore Carpaccio', date: 'c. 1505' },
	{ src: imgThinkingOver, title: 'Thinking It Over', artist: 'Thomas Waterman Wood', date: '1884' },
	{ src: imgWomanBalance, title: 'Woman Holding a Balance', artist: 'Johannes Vermeer', date: 'c. 1664' },
	{ src: imgThinking2, title: 'Thinking Woman', artist: 'Abraham Ajay', date: 'c. 1935' },
	{ src: imgThinking3, title: 'The Writing Master', artist: 'Thomas Eakins', date: '1882' },
	{ src: imgThinking6, title: 'The Chess Players', artist: 'Thomas Eakins', date: '1876' },
	{ src: img0000405625, title: 'The Astronomer', artist: 'Johannes Vermeer', date: 'c. 1668' },
	{ src: imgCHSDM, title: 'The Interior of a Textile Factory', artist: 'Unknown artist', date: '1720-1750' },
	{ src: imgNPG, title: 'Patent Office, Model Room (Washington, D.C.)', artist: 'Unknown photographer', date: 'c. 1906' },
	{ src: imgSAAM, title: 'The Woodworker', artist: 'Eastman Johnson', date: '1877' },
	{ src: imgThink, title: 'Curiosity', artist: 'Gerard ter Borch the Younger', date: 'ca. 1660-62' },
	{ src: imgThink11, title: 'Alchemist Interior', artist: 'Unknown artist', date: '17th century' },
	{ src: imgThink12, title: 'Telephone Switchboard Operators', artist: 'Unknown photographer', date: 'c. 1940s' },
	{ src: imgThinker6, title: "A Scholar in His Study ('Faust')", artist: 'Rembrandt', date: 'ca. 1652' },
];

const optimizedThinkingImages = await Promise.all(
	thinkingImageSources.map(img =>
		getImage({
			src: img.src.src,
			width: 800,
			height: Math.round((img.src.height / img.src.width) * 800),
			format: 'webp',
			quality: 80
		})
	)
);

const thinkingImages = optimizedThinkingImages.map((img, index) => ({
	src: img.src,
	title: thinkingImageSources[index].title,
	artist: thinkingImageSources[index].artist,
	date: thinkingImageSources[index].date,
}));

const posts = await getCollection('posts');
const latestEntry = posts
	.filter((post) => post.data.category === 'changelog' && !post.data.unpublished)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())[0];
const latestImage = latestEntry ? getPostImage(latestEntry) : null;
const optimizedLatestImage = latestImage
	? await getImage({
			src: latestImage.src,
			width: 320,
			height: 160,
			format: 'webp',
			quality: 80,
		})
	: null;
const latestPost = latestEntry
	? {
			title: latestEntry.data.title,
			href: `/changelog/${latestEntry.id.replace(/\/page$/, '')}/`,
			imageSrc: optimizedLatestImage?.src ?? null,
		}
	: null;

---

<MarketingLayout
	title="Rivet - Infrastructure for the Agentic Era"
	description="Rivet is infrastructure for the agentic era. Orchestrate agents, operate their environment, automate their work, and deploy what they build."
	canonicalUrl="https://rivet.dev/"
>
	<main id="main-content" tabindex="-1">
		<RedesignedHero latestPost={latestPost} thinkingImages={thinkingImages} client:load />
		<SectionRule />
		<StackSection />
		<SectionRule />
		<AgentStackSection />
		<SectionRule />
		<IntegrationsSection />
		<SectionRule />
		<OnPremSection />
		<SectionRule />
		<ObservabilitySection />
		<SectionRule />
		<HostingSection />
		<SectionRule />
		<ClosingCtaPanel
			title="Infrastructure for the agentic era."
			description="Build with agents, build for agents, and run it where your data lives."
		>
			<a href="/docs/" class={INK_PANEL_LIGHT_BUTTON_CLASS}>Start Building</a>
			<a href="/talk-to-an-engineer/" class={INK_PANEL_GHOST_BUTTON_CLASS}>Talk to an Engineer</a>
		</ClosingCtaPanel>
	</main>
</MarketingLayout>

<script>
	type AgentStackStoryController = {
		destroy: () => void;
	};

	const agentStackWindow = window as typeof window & {
		__rivetAgentStackStoryController?: AgentStackStoryController;
	};

	agentStackWindow.__rivetAgentStackStoryController?.destroy();

	// Match Tailwind's rem-based `lg` breakpoint without leaving a fractional gap.
	const mobileViewport = window.matchMedia('(max-width: 63.999rem)');
	const phoneViewport = window.matchMedia('(max-width: 47.999rem)');
	let observers: IntersectionObserver[] = [];
	let resizeFrame = 0;

	const disconnectObservers = () => {
		for (const observer of observers) observer.disconnect();
		observers = [];
	};

	const bindAgentStackStory = () => {
		disconnectObservers();
		if (!mobileViewport.matches || !('IntersectionObserver' in window)) return;

		for (const story of document.querySelectorAll<HTMLElement>('[data-agent-stack-story]')) {
			const steps = Array.from(
				story.querySelectorAll<HTMLElement>('[data-agent-stack-step]'),
			);
			if (steps.length === 0) continue;

			const stepsAboveReadingLine = new Set<HTMLElement>();
			const setActiveStep = () => {
				let activeStep = steps[0];
				for (const step of steps) {
					if (stepsAboveReadingLine.has(step)) activeStep = step;
				}

				const activeLayer = activeStep.dataset.agentStackStep;
				if (!activeLayer) return;

				story.dataset.activeLayer = activeLayer;
				for (const step of steps) {
					if (step === activeStep) step.setAttribute('aria-current', 'step');
					else step.removeAttribute('aria-current');
				}
			};

			const readingLine = phoneViewport.matches ? 0.7 : 0.58;
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!(entry.target instanceof HTMLElement)) continue;
						const step = entry.target.closest<HTMLElement>('[data-agent-stack-step]');
						if (!step) continue;
						if (entry.isIntersecting) stepsAboveReadingLine.add(step);
						else stepsAboveReadingLine.delete(step);
					}
					setActiveStep();
				},
				// On phones the card clears the sticky diagram before activation.
				// In the tablet two-column layout, keep the reading line near center.
				{ rootMargin: `100000px 0px -${window.innerHeight * (1 - readingLine)}px 0px` },
			);

			for (const step of steps) {
				observer.observe(step.querySelector<HTMLElement>('[data-agent-stack-card]') ?? step);
			}
			observers.push(observer);
		}
	};

	const handleViewportChange = () => bindAgentStackStory();
	const handleViewportResize = () => {
		window.cancelAnimationFrame(resizeFrame);
		resizeFrame = window.requestAnimationFrame(bindAgentStackStory);
	};
	const destroy = () => {
		disconnectObservers();
		window.cancelAnimationFrame(resizeFrame);
		document.removeEventListener('astro:page-load', bindAgentStackStory);
		mobileViewport.removeEventListener('change', handleViewportChange);
		window.removeEventListener('resize', handleViewportResize);
		if (agentStackWindow.__rivetAgentStackStoryController?.destroy === destroy) {
			delete agentStackWindow.__rivetAgentStackStoryController;
		}
	};

	agentStackWindow.__rivetAgentStackStoryController = { destroy };
	document.addEventListener('astro:page-load', bindAgentStackStory);
	mobileViewport.addEventListener('change', handleViewportChange);
	window.addEventListener('resize', handleViewportResize);
	bindAgentStackStory();
</script>
