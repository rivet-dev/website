---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import FaqJsonLd from '@/components/faq/FaqJsonLd.astro';
import { ProductLockup } from '@/components/marketing/ProductLockup';
import { ClosingCtaPanel } from '@/components/marketing/ClosingCtaPanel';
import { DeploymentOptions } from '@/components/marketing/DeploymentOptions';
import { WorkflowRunDemo } from '@/components/marketing/workflows/WorkflowRunDemo';
import {
	WorkflowCodeTabs,
	type WorkflowCodeTab,
} from '@/components/marketing/workflows/WorkflowCodeTabs';
import {
	EYEBROW_CLASS,
	INK_PANEL_GHOST_BUTTON_CLASS,
	INK_PANEL_LIGHT_BUTTON_CLASS,
	PRODUCT_HERO_CTA_ROW_CLASS,
	PRODUCT_HERO_H1_CLASS,
	PRODUCT_HERO_INNER_CLASS,
	PRODUCT_HERO_PRIMARY_BUTTON_CLASS,
	PRODUCT_HERO_SECTION_CLASS,
	PRODUCT_HERO_SUBTITLE_CLASS,
	SECTION_H2_CLASS,
	SECTION_LEDE_CLASS,
} from '@/components/marketing/typography';
import { workflowsFaqs } from '@/data/faqs/workflows';
import { highlightCodeHtml } from '@/lib/highlight-code';
import { loadSnippet } from '@/mdx/remark-code-snippet';
import { requireDocsRoot } from '@/sitemap/docs-sources.node';
import { getProduct } from '@/sitemap/products';

const WORKFLOW_SOURCE_ROOT =
	'https://github.com/rivet-dev/rivet/tree/main/rivetkit-typescript/packages/rivetkit/src/workflow';
const ACTOR_EXAMPLE_ROOT =
	'https://github.com/rivet-dev/rivet/blob/main/examples/docs/actors-workflows';
const AGENTOS_EXAMPLE_ROOT =
	'https://github.com/rivet-dev/agentos/blob/main/examples/workflows';
const INSPECTOR_IMAGE =
	'https://assets.rivet.dev/website/blog/2026-02-24-introducing-rivet-workflows/inspectorworkflow.png';

const actorsRoot = requireDocsRoot('actors');
const agentOSRoot = requireDocsRoot('agentos');
const workflowsProduct = getProduct('workflows');

if (!workflowsProduct) {
	throw new Error('Missing Workflows product metadata');
}

async function sourceTab(input: {
	key: string;
	label: string;
	root: string;
	file: string;
	region?: string;
	documentationUrl: string;
	sourceUrl: string;
}): Promise<WorkflowCodeTab> {
	const snippet = loadSnippet(input.root, input.file, input.region);
	return {
		key: input.key,
		label: input.label,
		raw: snippet.value,
		highlighted: await highlightCodeHtml(snippet.value, snippet.lang),
		documentationUrl: input.documentationUrl,
		sourceUrl: input.sourceUrl,
	};
}

const progressTabs = await Promise.all([
	sourceTab({
		key: 'invoice',
		label: 'invoice.ts',
		root: actorsRoot,
		file: 'examples/docs/actors-workflows/simple-workflow/index.ts',
		documentationUrl: '/workflows/docs/quickstart',
		sourceUrl: `${ACTOR_EXAMPLE_ROOT}/simple-workflow/index.ts`,
	}),
]);

const coordinationTabs = await Promise.all([
	sourceTab({
		key: 'approval',
		label: 'Approval wait',
		root: actorsRoot,
		file: 'examples/docs/actors-workflows/approval-gate.ts',
		documentationUrl: '/workflows/docs/queues',
		sourceUrl: `${ACTOR_EXAMPLE_ROOT}/approval-gate.ts`,
	}),
	sourceTab({
		key: 'fan-in-out',
		label: 'Fan-out / fan-in',
		root: actorsRoot,
		file: 'examples/docs/actors-workflows/fan-in-out.ts',
		documentationUrl: '/workflows/docs/timers-and-concurrency',
		sourceUrl: `${ACTOR_EXAMPLE_ROOT}/fan-in-out.ts`,
	}),
	sourceTab({
		key: 'timeouts',
		label: 'Retries + timeout',
		root: actorsRoot,
		file: 'examples/docs/actors-workflows/timeouts.ts',
		documentationUrl: '/workflows/docs/timers-and-concurrency',
		sourceUrl: `${ACTOR_EXAMPLE_ROOT}/timeouts.ts`,
	}),
	sourceTab({
		key: 'saga',
		label: 'Cross-Actor saga',
		root: actorsRoot,
		file: 'examples/docs/actors-workflows/cross-actor-saga.ts',
		documentationUrl: '/workflows/docs/failure-and-recovery',
		sourceUrl: `${ACTOR_EXAMPLE_ROOT}/cross-actor-saga.ts`,
	}),
]);

const agentWorkTabs = await Promise.all([
	sourceTab({
		key: 'bug-fixer',
		label: 'bug-fixer.ts',
		root: agentOSRoot,
		file: 'examples/workflows/server.ts',
		region: 'basic',
		documentationUrl: '/workflows/docs/patterns',
		sourceUrl: `${AGENTOS_EXAMPLE_ROOT}/server.ts#L1-L73`,
	}),
]);

const versioningTabs = await Promise.all([
	sourceTab({
		key: 'version-gate',
		label: 'Version gate',
		root: actorsRoot,
		file: 'examples/docs/actors-workflows/get-version.ts',
		documentationUrl: '/workflows/docs/versioning',
		sourceUrl: `${ACTOR_EXAMPLE_ROOT}/get-version.ts`,
	}),
	sourceTab({
		key: 'removed-entry',
		label: 'Removed entry',
		root: actorsRoot,
		file: 'examples/docs/actors-workflows/versioned-workflow.ts',
		documentationUrl: '/workflows/docs/versioning',
		sourceUrl: `${ACTOR_EXAMPLE_ROOT}/versioned-workflow.ts`,
	}),
]);

// What every run gets from the Actor it lives in. These double as the
// differentiators against cluster-based durable execution, stated positively.
const actorInheritance = [
	{
		title: 'A run per user, session, or agent',
		body: 'Address each workflow by key; every run keeps its own state, queue, and history.',
	},
	{
		title: 'State beside the steps',
		body: "Steps read and write the run's durable state in-process.",
	},
	{
		title: 'Waiting costs nothing',
		body: 'A run blocked on a queue wait or timer sleeps until the message or deadline arrives.',
	},
	{
		title: 'Progress in realtime',
		body: 'Broadcast step progress to connected clients as it happens.',
	},
];

const capabilities = [
	{
		title: 'Step history',
		body: "Every step's status, from pending through complete or failed.",
	},
	{
		title: 'Timing and retries',
		body: 'Durations, attempt counts, backoff delays, and terminal errors.',
	},
	{
		title: 'Inputs and outputs',
		body: 'The recorded values each step received and returned.',
	},
	{
		title: 'Replay',
		body: 'Re-run eligible steps after the underlying problem is fixed.',
	},
];

const compositionLayers = [
	{
		name: 'Actors',
		role: 'Required foundation',
		body: 'Every workflow is an Actor run handler. Actors provide identity, state, queues, and scheduling.',
		href: '/actors',
	},
	{
		name: 'agentOS',
		role: 'Optional computer',
		body: 'Adds files, processes, a shell, and networking when a workflow drives an agent using real tools.',
		href: '/agentos',
	},
	{
		name: 'Dynamic Apps',
		role: 'Optional delivery layer',
		body: 'Adds a generated backend when the workflow should ship an application to users.',
		href: '/dynamic-apps',
	},
];

---

<MarketingLayout
	productId="workflows"
	tabId="overview"
	active="product"
	title="Workflows: durable agent automation"
	description="Durable TypeScript workflows built on Rivet Actors: recorded steps, retries, human approvals, and runs that resume after restarts and deploys."
	canonicalUrl="https://rivet.dev/workflows/"
	keywords={[
		'agent workflows',
		'durable execution',
		'TypeScript workflows',
		'workflow coordination',
		'human in the loop',
		'open source infrastructure',
		'self-hosted workflows',
		'Rivet Actors',
	]}
>
	<FaqJsonLd items={workflowsFaqs} />

	<main id="main-content" tabindex="-1" class="paper-grain min-h-screen bg-paper font-sans text-ink-soft">
		<!-- Hero -->
		<section class={PRODUCT_HERO_SECTION_CLASS}>
			<div class="mx-auto w-full max-w-7xl">
				<div class={PRODUCT_HERO_INNER_CLASS}>
					<div class="mb-7 flex">
						<ProductLockup product={workflowsProduct} />
					</div>
					<h1 class={PRODUCT_HERO_H1_CLASS}>Automate agent work that outlives a process.</h1>
					<p class={PRODUCT_HERO_SUBTITLE_CLASS}>
						Durable workflows built on Rivet Actors. Steps record their results, wait for people or systems, and resume after crashes and deploys.
					</p>
					<div class={PRODUCT_HERO_CTA_ROW_CLASS}>
						<button
							type="button"
							data-workflows-install-copy
							aria-label="Copy npm install rivetkit"
							class="group relative flex w-full items-center justify-center gap-2.5 rounded-md border border-ink/15 bg-white/55 px-3.5 py-2.5 font-mono text-[13px] text-ink-soft transition-colors motion-reduce:transition-none hover:border-ink/30 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine/60 focus-visible:ring-offset-2 focus-visible:ring-offset-paper sm:w-auto"
						>
							<span aria-hidden="true" class="select-none text-pine">$</span>
							<span class="whitespace-nowrap">npm install rivetkit</span>
							<span data-workflows-copy-feedback aria-live="polite" class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded bg-ink px-2 py-1 font-sans text-xs text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">Copy</span>
						</button>
						<noscript>
							<code class="flex w-full select-all items-center justify-center gap-2.5 rounded-md border border-ink/15 bg-white/55 px-3.5 py-2.5 font-mono text-[13px] text-ink-soft sm:w-auto"><span aria-hidden="true" class="text-pine">$</span> npm install rivetkit</code>
						</noscript>
						<a href="/workflows/docs/quickstart" class={PRODUCT_HERO_PRIMARY_BUTTON_CLASS}>Start the quickstart</a>
					</div>
				</div>

				<div class="mx-auto mt-14 max-w-5xl md:mt-20">
					<WorkflowRunDemo client:load />
					<noscript>
						<style is:inline>
							.workflow-demo-controls, .workflow-code-controls, [data-workflows-install-copy] { display: none !important; }
						</style>
						<p class="mt-4 text-center text-sm text-ink-soft">The recorded run remains readable without JavaScript. Enable JavaScript to simulate a restart, approve the wait, or replay the demo.</p>
					</noscript>
				</div>
			</div>
		</section>

		<!-- Chapter 01 -->
		<section class="border-t border-ink/10 bg-paper-mid px-6 py-16 md:py-32">
			<div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-16">
				<div>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Regular TypeScript, durable progress.</h2>
					<p class={SECTION_LEDE_CLASS}>
						A workflow is an Actor <code class="font-mono text-[0.92em] text-ink">run</code> handler wrapped in <code class="font-mono text-[0.92em] text-ink">workflow()</code>. Name each step with <code class="font-mono text-[0.92em] text-ink">ctx.step()</code>; its result is recorded, and after a restart the handler replays history and reuses completed results.
					</p>
				</div>
				<div class="min-w-0">
					<WorkflowCodeTabs tabs={progressTabs} client:visible />
					<noscript>
						<p class="mt-4 text-sm text-ink-soft">JavaScript is optional for reading this page. View the <a class="text-pine underline underline-offset-2" href={progressTabs[0].sourceUrl}>invoice workflow source on GitHub</a>.</p>
					</noscript>
				</div>
			</div>

			<div class="mx-auto mt-14 max-w-7xl md:mt-20">
				<div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
					{actorInheritance.map((item) => (
						<div class="border-t border-ink/15 pt-5">
							<h3 class="text-base font-medium tracking-tight text-ink">{item.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Chapter 02 -->
		<section class="border-t border-ink/10 bg-paper px-6 py-16 md:py-32">
			<div class="mx-auto max-w-7xl">
				<div class="max-w-3xl">
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Wait, branch, and recover.</h2>
					<p class={SECTION_LEDE_CLASS}>
						Queue waits pause a run durably for approvals or external events. Timers, loops, joins, and races coordinate branches; per-step retries and timeouts absorb transient failures; rollback steps compensate multi-system changes.
					</p>
				</div>
				<div class="mt-12 min-w-0">
					<WorkflowCodeTabs tabs={coordinationTabs} client:visible />
					<noscript>
						<p class="mt-4 text-sm text-ink-soft">Browse the source-backed examples for <a class="text-pine underline underline-offset-2" href={coordinationTabs[0].sourceUrl}>approval waits</a>, <a class="text-pine underline underline-offset-2" href={coordinationTabs[1].sourceUrl}>joins</a>, <a class="text-pine underline underline-offset-2" href={coordinationTabs[2].sourceUrl}>timeouts</a>, and <a class="text-pine underline underline-offset-2" href={coordinationTabs[3].sourceUrl}>compensating actions</a>.</p>
					</noscript>
				</div>
			</div>
		</section>

		<!-- Chapter 03 -->
		<section class="border-t border-ink/10 bg-paper-mid px-6 py-16 md:py-32">
			<div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
				<div>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Automate agent work.</h2>
					<p class={SECTION_LEDE_CLASS}>
						With agentOS, this workflow gives an agent a computer: clone a repo, ask the agent to fix an issue, run the tests. Every step is recorded and resumes after a restart.
					</p>
				</div>
				<div class="min-w-0">
					<WorkflowCodeTabs tabs={agentWorkTabs} client:visible />
					<noscript>
						<p class="mt-4 text-sm text-ink-soft">Read the <a class="text-pine underline underline-offset-2" href={agentWorkTabs[0].sourceUrl}>agentOS bug-fix workflow source on GitHub</a>.</p>
					</noscript>
				</div>
			</div>
		</section>

		<!-- Chapter 04 -->
		<section class="border-t border-ink/10 bg-paper px-6 py-16 md:py-32">
			<div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
				<div>
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Evolve running work.</h2>
					<p class={SECTION_LEDE_CLASS}>
						Deploys land while runs are mid-flight. Keep step names stable, gate changed behavior with <code class="font-mono text-[0.92em] text-ink">getVersion()</code>, and mark deleted steps with <code class="font-mono text-[0.92em] text-ink">removed()</code> so old histories still replay.
					</p>
				</div>
				<div class="min-w-0">
					<WorkflowCodeTabs tabs={versioningTabs} client:visible />
					<noscript>
						<p class="mt-4 text-sm text-ink-soft">View the <a class="text-pine underline underline-offset-2" href={versioningTabs[0].sourceUrl}>version-gate</a> and <a class="text-pine underline underline-offset-2" href={versioningTabs[1].sourceUrl}>removed-entry</a> examples.</p>
					</noscript>
				</div>
			</div>
		</section>

		<!-- Inspector -->
		<section class="border-t border-ink/10 bg-paper-mid px-6 py-16 md:py-32">
			<div class="mx-auto max-w-7xl">
				<div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
					<div>
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>See the history behind every run.</h2>
						<p class={SECTION_LEDE_CLASS}>The built-in inspector renders each run's recorded history.</p>
					</div>
					<div class="grid gap-6 sm:grid-cols-2">
						{capabilities.map((capability) => (
							<div class="border-t border-ink/15 pt-5">
								<h3 class="text-base font-medium tracking-tight text-ink">{capability.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink-soft">{capability.body}</p>
							</div>
						))}
					</div>
				</div>

				<figure class="mt-12 overflow-hidden rounded-xl border border-ink/10 bg-white/55 p-2 sm:p-3">
					<img
						src={INSPECTOR_IMAGE}
						alt="Rivet workflow inspector showing a run history with nested steps, statuses, durations, and recorded details"
						width="4064"
						height="2634"
						loading="lazy"
						class="block h-auto w-full rounded-md border border-ink/10"
					/>
				</figure>

			</div>
		</section>

		<!-- Composition -->
		<section class="border-t border-ink/10 bg-paper px-6 py-16 md:py-32">
			<div class="mx-auto max-w-7xl">
				<div class="max-w-3xl">
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>One foundation. Optional layers.</h2>
					<p class={SECTION_LEDE_CLASS}>Workflows runs as an Actor <code class="font-mono text-[0.92em] text-ink">run</code> handler. Add the other layers when the job needs them.</p>
				</div>

				<div class="mt-12 grid overflow-hidden rounded-2xl border-l border-t border-ink/10 md:grid-cols-3">
					{compositionLayers.map((layer) => (
						<a href={layer.href} class="group flex min-h-64 flex-col border-b border-r border-ink/10 bg-white/55 p-6 transition-colors motion-reduce:transition-none hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-pine md:p-8">
							<p class={`${EYEBROW_CLASS} normal-case`}>{layer.role}</p>
							<h3 class="mt-5 text-xl font-medium tracking-[-0.01em] text-ink">{layer.name}</h3>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{layer.body}</p>
							<span class="mt-7 text-sm font-medium text-pine transition-colors group-hover:text-ink">Product overview <span aria-hidden="true">→</span></span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- Deployment -->
		<section class="border-t border-ink/10 bg-paper-mid px-6 py-16 md:py-32">
			<div class="mx-auto max-w-7xl">
				<div class="mb-12 max-w-3xl">
					<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Develop locally. Deploy your way.</h2>
					<p class={SECTION_LEDE_CLASS}>Run locally while you build, deploy on Rivet Cloud, or self-host the open-source control plane — the service that persists and schedules your Actors — on Docker, Kubernetes, or a VM.</p>
				</div>
				<DeploymentOptions
					productName="Workflows"
					quickstartHref="/workflows/docs/quickstart"
					selfHostHref="/workflows/self-host/control-plane"
					installCommand="npm install rivetkit"
				/>
			</div>
		</section>

		<section class="border-t border-ink/10 bg-paper px-6 py-16 md:py-24" aria-labelledby="workflows-faq-heading">
			<div class="mx-auto max-w-3xl">
				<h2 id="workflows-faq-heading" class={`mb-12 text-center text-balance ${SECTION_H2_CLASS}`}>Frequently asked questions</h2>
				<div class="divide-y divide-ink/10 border-b border-ink/10">
					{workflowsFaqs.map((item) => (
						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine [&::-webkit-details-marker]:hidden">
								{item.question}
								<svg viewBox="0 0 16 16" aria-hidden="true" class="h-4 w-4 shrink-0 text-ink-faint transition-transform motion-reduce:transition-none group-open:rotate-45">
									<path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
								</svg>
							</summary>
							<div class="pt-3 text-sm leading-relaxed text-ink-soft [&_a]:text-pine [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-ink" set:html={item.answerHtml} />
						</details>
					))}
				</div>
			</div>
		</section>

		<!-- Closing CTA: the hero owns this page's single ember action. -->
		<ClosingCtaPanel
			title="Ship a workflow that survives its first restart."
			description="Read the documentation or explore the Apache 2.0 source."
			background="paper-mid"
		>
			<a href="/workflows/docs" class={INK_PANEL_LIGHT_BUTTON_CLASS}>Documentation</a>
			<a href={WORKFLOW_SOURCE_ROOT} target="_blank" rel="noreferrer" class={INK_PANEL_GHOST_BUTTON_CLASS}>GitHub source</a>
		</ClosingCtaPanel>
	</main>
</MarketingLayout>

<script>
	function bindWorkflowsInstallCopy() {
		document.querySelectorAll('[data-workflows-install-copy]').forEach((element) => {
			if (!(element instanceof HTMLButtonElement) || element.dataset.copyBound === 'true') return;
			element.dataset.copyBound = 'true';
			const feedback = element.querySelector('[data-workflows-copy-feedback]');
			element.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText('npm install rivetkit');
					element.setAttribute('aria-label', 'Install command copied');
					if (feedback instanceof HTMLElement) {
						feedback.textContent = 'Copied';
						feedback.classList.remove('opacity-0');
						feedback.classList.add('opacity-100');
					}
					window.setTimeout(() => {
						element.setAttribute('aria-label', 'Copy npm install rivetkit');
						if (feedback instanceof HTMLElement) {
							feedback.textContent = 'Copy';
							feedback.classList.remove('opacity-100');
							feedback.classList.add('opacity-0');
						}
					}, 2_000);
				} catch {
					if (feedback instanceof HTMLElement) {
						feedback.textContent = 'Select and copy';
						feedback.classList.remove('opacity-0');
						feedback.classList.add('opacity-100');
						window.setTimeout(() => {
							feedback.textContent = 'Copy';
							feedback.classList.remove('opacity-100');
							feedback.classList.add('opacity-0');
						}, 2_000);
					}
				}
			});
		});
	}

	bindWorkflowsInstallCopy();
	document.addEventListener('astro:page-load', bindWorkflowsInstallCopy);
</script>
