---
// Workflows overview. Hero only until the rest of the marketing page is written.
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { ProductHero } from '@/components/marketing/ProductHero';
---

<MarketingLayout
	productId="workflows"
	tabId="overview"
	active="product"
	title="Workflows - Rivet"
	description="Durable, replayable multi-step operations."
>
	<main class="paper-grain font-sans text-ink-soft">
		<ProductHero
			productId="workflows"
			subtitle="Progress is saved automatically, replay follows the same recorded steps, and workflows can pause for queue messages then continue."
			docsHref="/workflows/docs"
			client:load
		/>
	</main>
</MarketingLayout>
