---
// The agentOS package catalog. Its own tab rather than a docs section: the
// storefront is a filterable island, not prose with a sidebar.
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import RegistryPageClient from '@/components/marketing/registry/RegistryPageClient';
import type { RegistryCardEntry } from '@/components/marketing/registry/RegistryPageClient';
import { registry } from '@/data/registry';
import {
	SITE_SECTION_CLASS,
	SITE_STANDARD_RAIL_CLASS,
	SITE_UTILITY_HERO_CLASS,
} from '@/components/marketing/layout';
import { HERO_H1_CLASS, SUBTITLE_CLASS } from '@/components/marketing/typography';

// Slim each entry down to the fields the storefront renders so multi-line
// config examples never ship in the island's serialized props.
const entries: RegistryCardEntry[] = registry.map((entry) => ({
	slug: entry.slug,
	title: entry.title,
	description: entry.description,
	types: entry.types,
	status: entry.status,
	featured: entry.featured,
	beta: entry.beta,
	icon: entry.icon,
	image: entry.image,
	href: entry.status === 'external' ? entry.href : undefined,
}));
---

<MarketingLayout
	productId="agentos"
	tabId="registry"
	active="product"
	title="Registry - agentOS - Rivet"
	description="Browse agents, bindings, file systems, and sandbox mounting for agentOS."
	canonicalUrl="https://rivet.dev/agentos/registry/"
>
	<main id="main-content" tabindex="-1">
		<section class={SITE_UTILITY_HERO_CLASS}>
			<div class={SITE_STANDARD_RAIL_CLASS}>
				<h1 class={HERO_H1_CLASS}>agentOS Registry</h1>
				<p class={`${SUBTITLE_CLASS} max-w-2xl`}>
					Agents, file systems, browsers, and software packages for agentOS.
				</p>
			</div>
		</section>

		<section class={SITE_SECTION_CLASS}>
			<div class={SITE_STANDARD_RAIL_CLASS}>
				<RegistryPageClient entries={entries} hrefBase="/agentos/registry" client:load />
			</div>
		</section>
	</main>
</MarketingLayout>
