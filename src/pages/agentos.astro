---
import AgentOSPage, { FILESYSTEM_CODE } from '@/components/marketing/agentos/AgentOSPage';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { highlightCodeHtml } from '@/lib/highlight-code';
import { ogImageFor } from '@/lib/ogImage';

const filesystemHighlightedCode = await highlightCodeHtml(FILESYSTEM_CODE, 'ts');
---

<MarketingLayout
	productId="agentos"
	active="product"
	title="agentOS - A Computer for Every Agent"
	description="A virtual operating system for agents, with files, processes, shell, and networking in one lightweight library."
	canonicalUrl="https://rivet.dev/agentos/"
	ogImage={ogImageFor('agentos')}
>
	<AgentOSPage
		filesystemHighlightedCode={filesystemHighlightedCode}
		client:load
	/>
</MarketingLayout>
