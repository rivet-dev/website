---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { jsonLdString } from '@/lib/jsonLd';
import { DeploymentBoundaryDiagram } from '@/components/marketing/diagrams/ConsolidatedStackDiagram';
import { CatalogCard } from '@/components/marketing/editorial/CatalogCard';
import { EnterpriseDeploymentModels } from '@/components/marketing/enterprise/EnterpriseDeploymentModels';
import { EnterpriseObservabilitySection } from '@/components/marketing/enterprise/EnterpriseObservabilitySection';
import {
	BODY_CLASS,
	HERO_H1_CLASS,
	INK_PANEL_GHOST_BUTTON_CLASS,
	INK_PANEL_LIGHT_BUTTON_CLASS,
	PRODUCT_HERO_PRIMARY_BUTTON_CLASS,
	PRODUCT_HERO_SECONDARY_BUTTON_CLASS,
	SECTION_H2_CLASS,
	SECTION_LEDE_CLASS,
} from '@/components/marketing/typography';
import { ClosingCtaPanel } from '@/components/marketing/ClosingCtaPanel';
import { SectionRule } from '@/components/marketing/SectionRule';
import {
	SITE_SECTION_CLASS,
	SITE_STANDARD_RAIL_CLASS,
	SITE_UTILITY_HERO_CLASS,
} from '@/components/marketing/layout';

const title = 'Rivet Enterprise';
const description =
	'Run Rivet on-prem, in your VPC, embedded in your customers’ environments, or fully air-gapped. The control plane can start as one binary, with no required outbound connections.';
const canonicalUrl = 'https://rivet.dev/enterprise/';
const SHOW_DEPLOYMENT_MODELS = false;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ name: 'Home', url: 'https://rivet.dev/' },
		{ name: 'Enterprise', url: canonicalUrl },
	].map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.name,
		item: item.url,
	})),
};

const boundaryControls = [
	'No required outbound control-plane connections',
	'Crash reporting can be disabled with one configuration flag',
	'Operator-selected network and storage boundaries',
	'Documented air-gapped deployment path',
	'Integrates with existing access and network controls',
];

const footprints = [
	{
		title: 'Single Rust binary',
		body: 'One process to install, monitor, and upgrade.',
	},
	{
		title: 'Kubernetes or systemd',
		body: 'Deploy with the Enterprise Helm chart or a systemd unit.',
	},
	{
		title: 'Mainstream databases',
		body: 'Runs on Postgres and SQLite. Backups and S3 storage are managed for you.',
	},
	{
		title: 'Local dev identical to production',
		body: 'Local development is the same as what you deploy to production.',
	},
];

const enterpriseEditionFeatures = [
	'Actor control plane',
	'FoundationDB persistence layer',
	'Cloud layer for multi-tenant',
	'SQLite backup',
	'SQLite PITR',
	'Forking',
	'ACL system',
	'ACL for agents',
	'Advanced ClickHouse analytics',
	'OpenTelemetry integration',
	'Alert manager rules, Prometheus rules, Grafana configs',
	'Kubernetes manifests',
	'Air-gapped & sovereign-cloud deployments',
	'Priority support & SLA',
	'Hardening guidance for FedRAMP, HIPAA, and regulated industries',
];
---

<MarketingLayout title={title} description={description} canonicalUrl={canonicalUrl}>
	<script type="application/ld+json" set:html={jsonLdString(breadcrumbSchema)} />
	<main id="main-content" tabindex="-1">
			<!-- Hero -->
			<section class={SITE_UTILITY_HERO_CLASS}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
						<div data-site-reveal-group data-site-reveal-stagger="40">
							<h1 class={HERO_H1_CLASS} data-site-reveal-child>Run Rivet inside your perimeter.</h1>
							<p class="mt-4 max-w-xl text-[17px] leading-relaxed text-ink-soft" data-site-reveal-child>
								Keep runtime, control plane, and data under the controls your team already
								operates. The same platform that powers Rivet Cloud.
							</p>
							<div class="mt-8 flex flex-col gap-3 sm:flex-row" data-site-reveal-child>
								<a href="/talk-to-an-engineer" class={PRODUCT_HERO_PRIMARY_BUTTON_CLASS}>
									Talk to an engineer
								</a>
								<a href="/actors/self-host/control-plane" class={PRODUCT_HERO_SECONDARY_BUTTON_CLASS}>
									Read self-hosting docs
								</a>
							</div>
						</div>
						<div class="mx-auto w-full min-w-0 max-w-2xl lg:max-w-none" data-site-reveal data-site-reveal-delay="120">
							<DeploymentBoundaryDiagram />
						</div>
					</div>
				</div>
			</section>

			<SectionRule />

			{
				SHOW_DEPLOYMENT_MODELS && (
					<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
						<div class={SITE_STANDARD_RAIL_CLASS}>
							<div class="max-w-3xl" data-site-reveal>
								<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Three ways to deploy.</h2>
								<p class={SECTION_LEDE_CLASS}>
									Start locally as a library and deploy inside your existing boundary.
								</p>
							</div>
							<EnterpriseDeploymentModels client:visible />
						</div>
					</section>
				)
			}

			{SHOW_DEPLOYMENT_MODELS && <SectionRule />}

			<!-- Enterprise Edition contents -->
			<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="max-w-3xl" data-site-reveal>
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Everything in Enterprise Edition.</h2>
						<p class={SECTION_LEDE_CLASS}>
							The multi-tenancy and operations layer on top of the open-source control plane.
						</p>
					</div>
					<ul class="mt-12 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3" data-site-reveal-group data-site-reveal-stagger="70">
						{
							enterpriseEditionFeatures.map((feature) => (
								<li class={`flex items-start gap-3 ${BODY_CLASS}`} data-site-reveal-child>
									<span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full border border-pine/30">
										<svg class="h-3 w-3 text-pine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									</span>
									{feature}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<SectionRule />

			<!-- Compliance posture -->
			<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16" data-site-reveal>
						<div>
							<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Keep deployment inside your existing boundary.</h2>
							<p class={SECTION_LEDE_CLASS}>
								The control plane runs under the controls you already have. Nothing needs to
								leave the boundary.
							</p>
						</div>
						<ul class="space-y-4">
							{
								boundaryControls.map((item) => (
									<li class={`flex items-start gap-3 ${BODY_CLASS}`}>
										<span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full border border-pine/30">
											<svg class="h-3 w-3 text-pine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
												<path d="M20 6 9 17l-5-5" />
											</svg>
										</span>
										{item}
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<SectionRule />

			<!-- Architecture footprint -->
			<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="max-w-3xl" data-site-reveal>
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>A footprint your ops team will sign off on.</h2>
						<p class={SECTION_LEDE_CLASS}>
							The same artifact runs from laptop to production.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-site-reveal-group data-site-reveal-stagger="70">
						{
							footprints.map((fp) => (
								<div class="h-full" data-site-reveal-child>
									<CatalogCard title={fp.title} className="flex h-full flex-col">
										<p class={`mt-2 flex-1 ${BODY_CLASS}`}>{fp.body}</p>
									</CatalogCard>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<SectionRule />

			<!-- Observability -->
			<EnterpriseObservabilitySection />

			<SectionRule />

			<!-- Closing CTA -->
			<ClosingCtaPanel
				title="Bring Rivet inside your boundary."
				description="Walk through your deployment model with an engineer, or start with the self-hosting docs and run it yourself."
				background="paper-mid"
			>
				<a href="/talk-to-an-engineer" class={INK_PANEL_LIGHT_BUTTON_CLASS}>
					Talk to an engineer
				</a>
				<a href="/actors/self-host/control-plane" class={INK_PANEL_GHOST_BUTTON_CLASS}>
					Read self-hosting docs
				</a>
			</ClosingCtaPanel>
	</main>
</MarketingLayout>
