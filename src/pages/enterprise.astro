---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { jsonLdString } from '@/lib/jsonLd';
import { PerimeterDiagram } from '@/components/marketing/editorial/PerimeterDiagram';
import { CatalogCard } from '@/components/marketing/editorial/CatalogCard';
import {
	BODY_CLASS,
	HERO_H1_CLASS,
	INK_PANEL_GHOST_BUTTON_CLASS,
	INK_PANEL_LIGHT_BUTTON_CLASS,
	PRODUCT_HERO_PRIMARY_BUTTON_CLASS,
	PRODUCT_HERO_SECONDARY_BUTTON_CLASS,
	SECTION_H2_CLASS,
	SECTION_LEDE_CLASS,
} from '@/components/marketing/typography';
import { ClosingCtaPanel } from '@/components/marketing/ClosingCtaPanel';
import {
	SITE_SECTION_CLASS,
	SITE_STANDARD_RAIL_CLASS,
	SITE_UTILITY_HERO_CLASS,
} from '@/components/marketing/layout';

const title = 'Rivet Enterprise';
const description =
	'Run Rivet on-prem, in your VPC, embedded in your customers’ environments, or fully air-gapped. The control plane can start as one binary, with no required outbound connections.';
const canonicalUrl = 'https://rivet.dev/enterprise/';

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ name: 'Home', url: 'https://rivet.dev/' },
		{ name: 'Enterprise', url: canonicalUrl },
	].map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.name,
		item: item.url,
	})),
};

const deploymentModels = [
	{
		index: '01',
		title: 'Your VPC',
		body: 'Start the same control plane that powers Rivet Cloud as one binary inside your perimeter. No outbound calls are required, and crash reporting switches off with one config flag.',
	},
	{
		index: '02',
		title: 'Embedded in your customers',
		body: 'Ship the control plane inside a customer VPC, regulated environment, or on-prem hardware. The operator chooses the network and storage boundary.',
	},
	{
		index: '03',
		title: 'Air-gapped',
		body: 'Deploy the control plane on disconnected networks using artifacts approved for that environment.',
	},
];

const boundaryControls = [
	'No required outbound control-plane connections',
	'Crash reporting can be disabled with one configuration flag',
	'Operator-selected network and storage boundaries',
	'Documented air-gapped deployment path',
	'Integrates with existing access and network controls',
];

const footprints = [
	{
		title: 'Single binary',
		body: 'One process to install, monitor, and upgrade. Ideal for evaluation, embedded deployments, and air-gapped installs.',
	},
	{
		title: 'Docker Compose',
		body: 'A complete environment in one file. Stand up Rivet alongside your existing services without changing how you operate them.',
	},
	{
		title: 'Kubernetes',
		body: 'Scale out across nodes and regions when traffic demands it. The same artifact you evaluated runs in production.',
	},
];

const enterpriseEditionFeatures = [
	'Actor control plane',
	'FoundationDB persistence layer',
	'Cloud layer for multi-tenant',
	'SQLite backup',
	'SQLite PITR',
	'Forking',
	'ACL system',
	'ACL for agents',
	'Advanced ClickHouse analytics',
	'OpenTelemetry integration',
	'Alert manager rules, Prometheus rules, Grafana configs',
	'Kubernetes manifests',
	'Air-gapped & sovereign-cloud deployments',
	'Priority support & SLA',
	'Hardening guidance for FedRAMP, HIPAA, and regulated industries',
];
---

<MarketingLayout title={title} description={description} canonicalUrl={canonicalUrl}>
	<script type="application/ld+json" set:html={jsonLdString(breadcrumbSchema)} />
	<main id="main-content" tabindex="-1">
			<!-- Hero -->
			<section class={SITE_UTILITY_HERO_CLASS}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
						<div>
							<h1 class={HERO_H1_CLASS}>Run Rivet inside your perimeter.</h1>
							<p class="mt-4 max-w-xl text-[17px] leading-relaxed text-ink-soft">
								Deploy Rivet in your VPC, embed it in your customers’ environments, or run it
								fully air-gapped. The same platform that powers Rivet Cloud, under your control.
							</p>
							<div class="mt-8 flex flex-col gap-3 sm:flex-row">
								<a href="/talk-to-an-engineer" class={PRODUCT_HERO_PRIMARY_BUTTON_CLASS}>
									Talk to an engineer
								</a>
								<a href="/actors/self-host/control-plane" class={PRODUCT_HERO_SECONDARY_BUTTON_CLASS}>
									Read self-hosting docs
								</a>
							</div>
						</div>
						<PerimeterDiagram />
					</div>
				</div>
			</section>

			<!-- Deployment models -->
			<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="max-w-3xl">
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Three ways to deploy.</h2>
						<p class={SECTION_LEDE_CLASS}>
							Rivet ships as software you run, not a service you call out to. Pick the
							boundary, and Rivet stays inside it.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
						{
							deploymentModels.map((model) => (
								<CatalogCard title={model.title}>
									<p class={`mt-2 ${BODY_CLASS}`}>{model.body}</p>
								</CatalogCard>
							))
						}
					</div>
				</div>
			</section>

			<!-- Enterprise Edition contents -->
			<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="max-w-3xl">
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Everything in Enterprise Edition.</h2>
						<p class={SECTION_LEDE_CLASS}>
							Additional operational features on top of the open-source control plane. The
							multi-tenancy and operations layer for running Rivet in larger deployments,
							in your own VPC, customer environments, or regulated networks.
						</p>
					</div>
					<ul class="mt-12 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
						{
							enterpriseEditionFeatures.map((feature) => (
								<li class={`flex items-start gap-3 ${BODY_CLASS}`}>
									<span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full border border-pine/30">
										<svg class="h-3 w-3 text-pine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									</span>
									{feature}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- Compliance posture -->
			<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
						<div>
							<h2 class={`text-balance ${SECTION_H2_CLASS}`}>Keep deployment inside your existing boundary.</h2>
							<p class={SECTION_LEDE_CLASS}>
								Use the self-hosted architecture inside environments governed by your existing
								controls. Review Rivet configuration, dependencies, and operating procedures
								with your security team for the requirements that apply to your deployment.
							</p>
						</div>
						<ul class="space-y-4">
							{
								boundaryControls.map((item) => (
									<li class={`flex items-start gap-3 ${BODY_CLASS}`}>
										<span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full border border-pine/30">
											<svg class="h-3 w-3 text-pine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
												<path d="M20 6 9 17l-5-5" />
											</svg>
										</span>
										{item}
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<!-- Architecture footprint -->
			<section class={`bg-paper ${SITE_SECTION_CLASS}`}>
				<div class={SITE_STANDARD_RAIL_CLASS}>
					<div class="max-w-3xl">
						<h2 class={`text-balance ${SECTION_H2_CLASS}`}>A footprint your ops team will sign off on.</h2>
						<p class={SECTION_LEDE_CLASS}>
							The self-hosted control plane ships as a Rust binary and container, with documented
							Docker Compose, Kubernetes, and VM deployment paths.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
						{
							footprints.map((fp) => (
								<CatalogCard title={fp.title} className="flex flex-col">
									<p class={`mt-2 ${BODY_CLASS}`}>{fp.body}</p>
								</CatalogCard>
							))
						}
					</div>
				</div>
			</section>

			<!-- Closing CTA -->
			<ClosingCtaPanel
				title="Bring Rivet inside your boundary."
				description="Walk through your deployment model with an engineer, or start with the self-hosting docs and run it yourself."
				background="paper-mid"
			>
				<a href="/talk-to-an-engineer" class={INK_PANEL_LIGHT_BUTTON_CLASS}>
					Talk to an engineer
				</a>
				<a href="/actors/self-host/control-plane" class={INK_PANEL_GHOST_BUTTON_CLASS}>
					Read self-hosting docs
				</a>
			</ClosingCtaPanel>
	</main>
</MarketingLayout>
