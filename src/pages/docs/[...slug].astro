---
// Product-agnostic documentation: /docs/{...slug}.
//
//   src/content/docs/docs/index.mdx  ->  /docs/       the docs overview
//   src/content/docs/docs/mcp.mdx    ->  /docs/mcp/   canonical AI Tools page
//
// Product documentation keeps its own /{product}/{tab}/{...slug} route, and
// the Deploy section has its own routes under /docs/deploy/.
import { getCollection } from 'astro:content';
import DocsArticlePage from '@/components/docs/DocsArticlePage.astro';
import { createGuideCards } from '@/components/docs/GuideCards';
import Onboarding from '@/components/docs/Onboarding.astro';
import { diagramFromMdx, type DiagramSpec } from '@/components/docs/diagram/fromMdx';
import { getContentParamSlug } from '@/lib/content-path';
import { getRouteSeoPolicy, robotsDirective } from '@/lib/routeSeoPolicy';
import { AI_DOCS_ITEMS } from '@/sitemap/ai';
import { SITE_DOCS_NAMESPACE, SITE_DOCS_ROUTE_PREFIX } from '@/sitemap/docs-sources';
import { guideForContentId, guideHref } from '@/sitemap/guides';

export async function getStaticPaths() {
	const entries = await getCollection('docs');
	const entryPrefix = `${SITE_DOCS_NAMESPACE}/`;

	return entries
		.filter((entry) => entry.id === SITE_DOCS_NAMESPACE || entry.id.startsWith(entryPrefix))
		.map((entry) => ({
			params: {
				// The glob loader collapses `docs/index.mdx` to the id `docs`.
				slug:
					entry.id === SITE_DOCS_NAMESPACE
						? undefined
						: getContentParamSlug(entry.id.slice(entryPrefix.length)),
			},
			props: { entry },
		}));
}

const { entry } = Astro.props;
const entryPrefix = `${SITE_DOCS_NAMESPACE}/`;
const robots = robotsDirective(getRouteSeoPolicy(Astro.url));
const isOverview = entry.id === SITE_DOCS_NAMESPACE;
// The AI Tools pages are canonical here and aliased into every product, so the
// shared record owns their edit link back into the `rivet` bundle.
const aiItem = AI_DOCS_ITEMS.find((item) => item.contentId === entry.id);

// The overview opens with per-product quickstarts (`<Onboarding />`), then
// lists every guide (`<GuideCards />`), which needs each guide's description
// and diagram for the cards.
const descriptions: Record<string, string | undefined> = {};
const diagrams: Record<string, DiagramSpec | undefined> = {};
if (isOverview) {
	for (const guideEntry of await getCollection('docs')) {
		const guide = guideForContentId(guideEntry.id);
		if (!guide) continue;
		descriptions[guideHref(guide.slug)] = guideEntry.data.description;
		diagrams[guideHref(guide.slug)] = diagramFromMdx(guideEntry.body);
	}
}
---

<DocsArticlePage
	entry={entry}
	routePrefix={SITE_DOCS_ROUTE_PREFIX}
	entryIdPrefix={entryPrefix}
	breadcrumbName="Documentation"
	sectionLabel="Documentation"
	seoContextLabel="Rivet documentation"
	canonicalUrl={isOverview ? 'https://rivet.dev/docs/' : undefined}
	editUrlOverride={
		isOverview
			? 'https://github.com/rivet-dev/website/edit/main/src/content/docs/docs/index.mdx'
			: aiItem?.editUrl
	}
	exactTitle={aiItem?.id === 'mcp' || isOverview}
	extraComponents={isOverview ? {
		GuideCards: createGuideCards({ descriptions, diagrams }),
		Onboarding,
	} : {}}
	robots={robots}
/>
