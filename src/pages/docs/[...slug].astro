---
// Website-owned documentation: /docs/{...slug}.
//
//   src/content/docs/docs/index.mdx  ->  /docs/       the docs overview
//   src/content/docs/docs/mcp.mdx    ->  /docs/mcp/   rendered inside the Actors docs shell
//
// Product documentation keeps its own /{product}/{tab}/{...slug} route, and
// the Deploy section has its own routes under /docs/deploy/.
import { getCollection } from 'astro:content';
import DocsArticlePage from '@/components/docs/DocsArticlePage.astro';
import { getContentParamSlug } from '@/lib/content-path';
import { getRouteSeoPolicy, robotsDirective } from '@/lib/routeSeoPolicy';
import { SITE_DOCS_NAMESPACE } from '@/sitemap/docs-sources';

export async function getStaticPaths() {
	const entries = await getCollection('docs');
	const entryPrefix = `${SITE_DOCS_NAMESPACE}/`;

	return entries
		.filter((entry) => entry.id === SITE_DOCS_NAMESPACE || entry.id.startsWith(entryPrefix))
		.map((entry) => ({
			params: {
				// The glob loader collapses `docs/index.mdx` to the id `docs`.
				slug:
					entry.id === SITE_DOCS_NAMESPACE
						? undefined
						: getContentParamSlug(entry.id.slice(entryPrefix.length)),
			},
			props: { entry },
		}));
}

const { entry } = Astro.props;
const entryPrefix = `${SITE_DOCS_NAMESPACE}/`;
const robots = robotsDirective(getRouteSeoPolicy(Astro.url));
const isMcp = entry.id === 'docs/mcp';
const isOverview = entry.id === SITE_DOCS_NAMESPACE;
---

<DocsArticlePage
	entry={entry}
	routePrefix="/docs"
	entryIdPrefix={entryPrefix}
	breadcrumbName="Documentation"
	productId={isMcp ? 'actors' : undefined}
	tabId={isMcp ? 'docs' : undefined}
	sectionLabel={isMcp ? undefined : 'Documentation'}
	seoContextLabel="Rivet documentation"
	canonicalUrl={isMcp ? 'https://rivet.dev/docs/mcp/' : isOverview ? 'https://rivet.dev/docs/' : undefined}
	editUrlOverride={
		isMcp
			? 'https://github.com/rivet-dev/website/edit/main/src/content/docs/docs/mcp.mdx'
			: isOverview
				? 'https://github.com/rivet-dev/website/edit/main/src/content/docs/docs/index.mdx'
				: undefined
	}
	exactTitle={isMcp || isOverview}
	robots={robots}
/>
