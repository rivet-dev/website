---
// Top-level Documentation landing: a product index. The header's "Documentation"
// link lands here rather than jumping straight into one product's docs, so
// choosing a product is an explicit step.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Header } from '@/components/v2/Header';
import { DocsLanding } from '@/components/docs/DocsLanding';
import { visibleProducts as products } from '@/sitemap/products';
import { productLogos } from '@/sitemap/productLogos';
import { productAccent } from '@/lib/product-accent';
import { AI_DOCS_ITEMS } from '@/sitemap/ai';
import { faPlug, faSparkles, faSquareInfo } from '@rivet-gg/icons';

const pathname = Astro.url.pathname;

const landing = {
	title: 'Documentation',
	subtitle:
		'Choose a product, or connect your AI client to Rivet.',
	// Two columns: four products in a three-up grid leaves a ragged 3 + 1.
	columns: 2 as const,
	sections: [
		{
			title: 'Products',
			items: products.map((product) => {
				const accent = productAccent(product.id);
				return {
					title: product.name,
					href: `/${product.id}/docs`,
					icon: product.icon ?? faSquareInfo,
					logoSrc: productLogos[product.id]?.src,
					logoClassName: accent?.fill,
					hoverBorderClassName: accent?.borderHover,
					description: product.description,
				};
			}),
		},
		{
			title: 'AI Tools',
			items: AI_DOCS_ITEMS.map((item) => ({
				...item,
				icon: item.id === 'mcp' ? faPlug : faSparkles,
			})),
		},
	],
};
---

<BaseLayout
	title="Developer Documentation for Rivet Products"
	description="Build with Rivet Actors, agentOS, Workflows, and Dynamic Apps using guides, API references, deployment options, and examples."
	canonicalUrl="https://rivet.dev/docs/"
	themeColor="#EFEFEF"
>
	<Header variant="full-width" light={true} active="docs" initialPathname={pathname} client:load />
	<main class="paper-grain selection-paper w-full relative z-10 font-sans">
		<div class="mx-auto w-full min-h-content" style="--header-height: 4.5rem;">
			<DocsLanding {...landing} />
		</div>
	</main>
</BaseLayout>

<style is:global>
	body {
		background-color: #efefef;
	}
</style>
