---
// The HTTP API reference: /docs/api/{...slug}.
//
//   src/content/docs/api/index.mdx                 ->  /docs/api/        the overview
//   src/content/docs/api/authentication.mdx        ->  /docs/api/authentication/
//   src/content/docs/api/actors/create.mdx         ->  /docs/api/actors/create/
//
// The bundle ships from `rivet-dev/rivet`'s `docs/api`, where the endpoint
// pages are generated from the OpenAPI specs. It nests under `/docs/` like the
// Deploy section, and the product-agnostic route (`../[...slug].astro`) only
// claims the `docs/` namespace, so the two cannot collide.
import { getCollection } from 'astro:content';
import DocsArticlePage from '@/components/docs/DocsArticlePage.astro';
import { getContentParamSlug } from '@/lib/content-path';
import { getRouteSeoPolicy, robotsDirective } from '@/lib/routeSeoPolicy';
import { API_DOCS_NAMESPACE, API_DOCS_ROUTE_PREFIX } from '@/sitemap/docs-sources';

export async function getStaticPaths() {
	const entries = await getCollection('docs');
	const entryPrefix = `${API_DOCS_NAMESPACE}/`;

	return entries
		.filter((entry) => entry.id === API_DOCS_NAMESPACE || entry.id.startsWith(entryPrefix))
		.map((entry) => ({
			params: {
				// The glob loader collapses `api/index.mdx` to the id `api`.
				slug:
					entry.id === API_DOCS_NAMESPACE
						? undefined
						: getContentParamSlug(entry.id.slice(entryPrefix.length)),
			},
			props: { entry },
		}));
}

const { entry } = Astro.props;
const entryPrefix = `${API_DOCS_NAMESPACE}/`;
const robots = robotsDirective(getRouteSeoPolicy(Astro.url));
const isOverview = entry.id === API_DOCS_NAMESPACE;
// The bundle is authored in the Rivet repo, so edit links point there. Generated
// endpoint pages carry their own "edit the generator input" note in the file.
const bundleFile = isOverview ? 'index.mdx' : `${entry.id.slice(entryPrefix.length)}.mdx`;
---

<DocsArticlePage
	entry={entry}
	routePrefix={API_DOCS_ROUTE_PREFIX}
	entryIdPrefix={entryPrefix}
	breadcrumbName="API"
	sectionLabel="HTTP API"
	seoContextLabel="Rivet HTTP API"
	canonicalUrl={isOverview ? 'https://rivet.dev/docs/api/' : undefined}
	editUrlOverride={`https://github.com/rivet-dev/rivet/edit/main/docs/api/content/${bundleFile}`}
	exactTitle={isOverview}
	robots={robots}
/>
