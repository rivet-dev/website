---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import {
	SITE_CARD_CLASS,
	SITE_NARROW_RAIL_CLASS,
	SITE_SECTION_CLASS,
	SITE_STANDARD_RAIL_CLASS,
	SITE_UTILITY_HERO_CLASS,
} from '@/components/marketing/layout';
import { SectionRule } from '@/components/marketing/SectionRule';
import {
	CARD_TITLE_CLASS,
	HERO_H1_CLASS,
	SUBTITLE_CLASS,
} from '@/components/marketing/typography';
import { Icon, faBook, faComments, faEnvelope } from "@rivet-gg/icons";
---

<MarketingLayout
	title="Support"
	description="Get help with Rivet Actors via email, Discord community, or documentation. Troubleshoot issues, request features, and connect with our team."
	canonicalUrl="https://rivet.dev/support/"
>
	<main id="main-content" tabindex="-1">
		<section class={`${SITE_UTILITY_HERO_CLASS} text-center`}>
			<div class={SITE_NARROW_RAIL_CLASS} data-site-reveal-group data-site-reveal-stagger="40">
				<h1 class={HERO_H1_CLASS} data-site-reveal-child>
					Support
				</h1>
				<p class={`${SUBTITLE_CLASS} mx-auto max-w-3xl`} data-site-reveal-child>
					Get help with Rivet, from troubleshooting to feature
					requests.
				</p>
			</div>
		</section>

		<SectionRule />

		<section class={`${SITE_SECTION_CLASS}`}>
			<div class={SITE_STANDARD_RAIL_CLASS}>
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-3" data-site-reveal-group data-site-reveal-stagger="70">
				<!-- Email Tile -->
				<a
					href="mailto:support@rivet.dev"
					class={`${SITE_CARD_CLASS} group relative flex min-h-[180px] flex-col items-center justify-center overflow-hidden transition-colors duration-200 hover:border-ink/25 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine focus-visible:ring-offset-4 focus-visible:ring-offset-paper`}
					data-site-reveal-child
				>
					<div class="flex flex-col items-center">
						<Icon
							icon={faEnvelope}
							className="text-3xl text-pine mb-2"
						/>
						<span class={`mb-1 ${CARD_TITLE_CLASS}`}>
							Email
						</span>
						<span class="text-ink-faint text-sm">
							support@rivet.dev
						</span>
					</div>
				</a>
				<!-- Discord Tile -->
				<a
					href="https://rivet.dev/discord"
					target="_blank"
					rel="noopener noreferrer"
					class={`${SITE_CARD_CLASS} group relative flex min-h-[180px] flex-col items-center justify-center overflow-hidden transition-colors duration-200 hover:border-ink/25 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine focus-visible:ring-offset-4 focus-visible:ring-offset-paper`}
					data-site-reveal-child
				>
					<div class="flex flex-col items-center">
						<Icon
							icon={faComments}
							className="text-3xl text-pine mb-2"
						/>
						<span class={`mb-1 ${CARD_TITLE_CLASS}`}>
							Discord
						</span>
						<span class="text-ink-faint text-sm">
							rivet.dev/discord
						</span>
					</div>
				</a>
				<!-- Docs Tile -->
				<a
					href="https://rivet.dev/actors/docs"
					target="_blank"
					rel="noopener noreferrer"
					class={`${SITE_CARD_CLASS} group relative flex min-h-[180px] flex-col items-center justify-center overflow-hidden transition-colors duration-200 hover:border-ink/25 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine focus-visible:ring-offset-4 focus-visible:ring-offset-paper`}
					data-site-reveal-child
				>
					<div class="flex flex-col items-center">
						<Icon
							icon={faBook}
							className="text-3xl text-pine mb-2"
						/>
						<span class={`mb-1 ${CARD_TITLE_CLASS}`}>
							Docs
						</span>
						<span class="text-ink-faint text-sm">
							rivet.dev/actors/docs
						</span>
					</div>
				</a>
				</div>
			</div>
		</section>
	</main>
</MarketingLayout>
