---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { HERO_H1_CLASS } from '@/components/marketing/typography';
import { Icon, faBook, faComments, faEnvelope } from "@rivet-gg/icons";
---

<MarketingLayout
	title="Support"
	description="Get help with Rivet Actors via email, Discord community, or documentation. Troubleshoot issues, request features, and connect with our team."
	canonicalUrl="https://rivet.dev/support/"
>
	<main id="main-content" tabindex="-1" class="paper-grain min-h-screen w-full bg-paper font-sans text-ink-soft">
		<section class="depth-wash relative isolate overflow-hidden px-6 pt-40 pb-16 text-center">
			<div class="mx-auto max-w-4xl">
				<h1 class={HERO_H1_CLASS}>
					Support
				</h1>
				<p class="mt-6 max-w-3xl mx-auto text-base leading-relaxed text-ink-soft md:text-lg">
					Get help with Rivet, from troubleshooting to feature
					requests.
				</p>
			</div>
		</section>

		<section class="border-t border-ink/10 px-6 py-16 md:py-24">
			<div class="mx-auto max-w-7xl">
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
				<!-- Email Tile -->
				<a
					href="mailto:support@rivet.dev"
					class="group relative flex h-[180px] flex-col items-center justify-center overflow-hidden rounded-2xl border border-ink/10 bg-white/55 p-7 transition-colors duration-200 hover:border-ink/25 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine focus-visible:ring-offset-4 focus-visible:ring-offset-paper"
				>
					<div class="flex flex-col items-center">
						<Icon
							icon={faEnvelope}
							className="text-3xl text-pine mb-2"
						/>
						<span class="font-medium text-ink text-lg mb-1">
							Email
						</span>
						<span class="text-ink-faint text-sm">
							support@rivet.dev
						</span>
					</div>
				</a>
				<!-- Discord Tile -->
				<a
					href="https://rivet.dev/discord"
					target="_blank"
					rel="noopener noreferrer"
					class="group relative flex h-[180px] flex-col items-center justify-center overflow-hidden rounded-2xl border border-ink/10 bg-white/55 p-7 transition-colors duration-200 hover:border-ink/25 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine focus-visible:ring-offset-4 focus-visible:ring-offset-paper"
				>
					<div class="flex flex-col items-center">
						<Icon
							icon={faComments}
							className="text-3xl text-pine mb-2"
						/>
						<span class="font-medium text-ink text-lg mb-1">
							Discord
						</span>
						<span class="text-ink-faint text-sm">
							rivet.dev/discord
						</span>
					</div>
				</a>
				<!-- Docs Tile -->
				<a
					href="https://rivet.dev/actors/docs"
					target="_blank"
					rel="noopener noreferrer"
					class="group relative flex h-[180px] flex-col items-center justify-center overflow-hidden rounded-2xl border border-ink/10 bg-white/55 p-7 transition-colors duration-200 hover:border-ink/25 hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine focus-visible:ring-offset-4 focus-visible:ring-offset-paper"
				>
					<div class="flex flex-col items-center">
						<Icon
							icon={faBook}
							className="text-3xl text-pine mb-2"
						/>
						<span class="font-medium text-ink text-lg mb-1">
							Docs
						</span>
						<span class="text-ink-faint text-sm">
							rivet.dev/actors/docs
						</span>
					</div>
				</a>
				</div>
			</div>
		</section>
	</main>
</MarketingLayout>
