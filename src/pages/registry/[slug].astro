---
// Detail pages for registry entries that have no page of their own elsewhere.
// External entries link straight out from the card, so only the first-party
// actor types land here.
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { actorRegistry } from '@/data/actor-registry';
import { RegistryIconTile } from '@/components/marketing/registry/RegistryIconTile';
import {
	SITE_NARROW_RAIL_CLASS,
	SITE_SECTION_CLASS,
	SITE_UTILITY_HERO_CLASS,
} from '@/components/marketing/layout';
import { SectionRule } from '@/components/marketing/SectionRule';
import {
	HERO_H1_CLASS,
	PRIMARY_INK_BUTTON_CLASS,
	SUBTITLE_CLASS,
} from '@/components/marketing/typography';
import { canonicalizeInternalHref } from '@/lib/internalHref';

export function getStaticPaths() {
	return actorRegistry
		.filter((entry) => entry.status !== 'external')
		.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<MarketingLayout
	title={`${entry.title} - Registry - Rivet`}
	description={entry.description}
	canonicalUrl={`https://rivet.dev/registry/${entry.slug}/`}
>
	<main id="main-content" tabindex="-1">
		<section class={SITE_UTILITY_HERO_CLASS}>
			<div class={SITE_NARROW_RAIL_CLASS} data-site-reveal>
				<a
					href={canonicalizeInternalHref('/registry/')}
					class="inline-flex items-center gap-1.5 text-sm text-ink-faint transition-colors hover:text-ink"
				>
					← Registry
				</a>
				<div class="mt-6 flex items-center gap-4">
					<RegistryIconTile
						icon={entry.icon}
						image={entry.image}
						productId={entry.productId}
						title={entry.title}
						size={48}
					/>
					<h1 class={HERO_H1_CLASS}>{entry.title}</h1>
				</div>
				<p class={`${SUBTITLE_CLASS} max-w-2xl`}>{entry.description}</p>
			</div>
		</section>

		<SectionRule />

		<section class={SITE_SECTION_CLASS}>
			<div class={SITE_NARROW_RAIL_CLASS} data-site-reveal>
				{entry.body ? (
					<p class="text-[17px] leading-relaxed text-ink-soft">{entry.body}</p>
				) : (
					<p class="text-[17px] leading-relaxed text-ink-soft">To do.</p>
				)}

				<div class="mt-10">
					<a
						href={canonicalizeInternalHref('/actors/docs/')}
						class={PRIMARY_INK_BUTTON_CLASS}
					>
						Read the docs
					</a>
				</div>
			</div>
		</section>
	</main>
</MarketingLayout>
