---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import {
	SITE_SECTION_CLASS,
	SITE_STANDARD_RAIL_CLASS,
	SITE_UTILITY_HERO_CLASS,
} from '@/components/marketing/layout';
import { HERO_H1_CLASS, SUBTITLE_CLASS } from '@/components/marketing/typography';
import { CatalogCard } from '@/components/marketing/editorial/CatalogCard';
import { SectionRule } from '@/components/marketing/SectionRule';

// Fetch OSS friends data at build time
let items: any[] = [];
try {
	const res = await fetch("https://formbricks.com/api/oss-friends");
	const data = await res.json();
	items = data.data || [];
} catch (e) {
	console.warn("Failed to fetch OSS friends:", e);
}
---

<MarketingLayout
	title="Open Source Friends - Rivet"
	description="Explore open-source companies and projects whose engineering culture, developer tools, and infrastructure work resonate with Rivet."
	canonicalUrl="https://rivet.dev/oss-friends/"
>
	<main id="main-content" tabindex="-1">
		<section class={SITE_UTILITY_HERO_CLASS}>
			<div class={SITE_STANDARD_RAIL_CLASS}>
				<div class="max-w-2xl" data-site-reveal-group data-site-reveal-stagger="40">
					<h1 class={HERO_H1_CLASS} data-site-reveal-child>
						Open Source Friends
					</h1>
					<p class={SUBTITLE_CLASS} data-site-reveal-child>
						Other companies whose code & culture mirrors that at Rivet.
					</p>
				</div>
			</div>
		</section>

		<SectionRule />

		<section class={`${SITE_SECTION_CLASS}`}>
			<div class={SITE_STANDARD_RAIL_CLASS}>
				<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					{items.map((friend: any) => (
						<div class="h-full" data-site-reveal>
							<CatalogCard href={friend.href} external title={friend.name} className="h-full">
								<p class="mt-2 text-[15px] leading-relaxed text-ink-soft">
									{friend.description}
								</p>
							</CatalogCard>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
</MarketingLayout>
