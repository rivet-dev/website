#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"

command -v node >/dev/null 2>&1 || {
	echo "Node.js is missing; run .agents/setup." >&2
	exit 1
}
command -v pnpm >/dev/null 2>&1 || {
	echo "pnpm is missing; run .agents/setup." >&2
	exit 1
}
[[ -x "$repo_root/node_modules/.bin/tsx" ]] || {
	echo "Workspace dependencies are missing; run .agents/setup." >&2
	exit 1
}

cd "$repo_root"
pnpm assemble

echo "Orb resumed; documentation sources are assembled."
